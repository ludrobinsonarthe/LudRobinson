
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================
    // Helper Functions
    // =============================================================

    function isAuth() {
      return request.auth != null;
    }

    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isAdmin() {
      return isAuth() && isRole('admin');
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasPermission(permission) {
      let roleId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin.roleId;
      // Allow super_admin to do anything
      if (roleId == 'super_admin') {
        return true;
      }
      let roleDoc = get(/databases/$(database)/documents/adminRoles/$(roleId));
      return roleDoc.data.permissions.hasAny([permission]);
    }
    
    // =============================================================
    // Collection Rules
    // =============================================================

    match /users/{userId} {
      // Any authenticated user can read their own data.
      // Admins with specific permissions can read/write any user.
      allow read: if isAuth() && (isOwner(userId) || hasPermission('manage_users') || hasPermission('manage_students'));
      allow list: if isAdmin() && (hasPermission('manage_users') || hasPermission('manage_students'));
      allow create, update: if isAdmin() && hasPermission('manage_users');
      allow delete: if isAdmin() && hasPermission('manage_users');
    }
    
    match /settings/system {
      // Everyone can read school settings (name, logo)
      allow get;
      // Only specific admins can change settings
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }
    
    match /announcements/{announcementId} {
      // Everyone can read announcements.
      allow read, list;
      // Only admins can create/edit/delete announcements.
      allow write: if isAdmin();
    }
    
    match /private_messages/{messageId} {
        // A user can read a message if they are the sender or receiver.
        allow read, list: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
        // A user can create a message if they are the sender.
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        // Nobody can update/delete messages for data integrity.
        allow update, delete: if false;
    }
    
    match /courses/{courseId} {
      // Any authenticated user can read course info.
      allow read, list;
      // Only admins with course management permissions can write.
      allow write: if isAdmin() && hasPermission('manage_course');
    }

    match /grades/{gradeId} {
      // Student can read their own grades.
      // Admins/teachers can read/write grades.
      allow read: if isAuth() && (resource.data.studentId == request.auth.uid || isAdmin() || isRole('teacher'));
      allow list: if isAdmin() || isRole('teacher');
      allow write: if (isAdmin() && hasPermission('manage_grades')) || (isRole('teacher'));
    }
    
    match /qr_sessions/{sessionId} {
      // Anyone can create a session (requester device)
      allow create;
      // Any authenticated user can update a session (validator device)
      // Any user can read the session to check for status change
      allow read, update: if isAuth();
      // Session documents should be deleted by the client or a cloud function.
      allow delete: if isAuth();
    }
    
    match /activityLogs/{logId} {
      // Only admins can read/write logs.
      allow read, list, write: if isAdmin() && hasPermission('manage_admin_settings');
    }

    match /adminRoles/{roleId} {
      allow read, list: if isAuth();
      allow write: if isAdmin() && hasPermission('manage_roles');
    }

    match /sectors/{sectorId} {
      allow read, list;
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }

    match /fields/{fieldId} {
      allow read, list;
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }
    
    match /feeStructures/{feeId} {
      allow read, list;
      allow write: if isAdmin() && hasPermission('manage_fees');
    }

    match /payments/{paymentId} {
      // Student can read their own payments and create new ones for themselves.
      allow read, create: if isAuth() && (resource.data.studentId == request.auth.uid || request.resource.data.studentId == request.auth.uid);
      // Admins can manage all payments.
      allow list, update, delete: if isAdmin() && hasPermission('manage_tuition');
    }
    
    match /teacherSalaries/{salaryId} {
      // Teachers can read their own salary slips
      allow read: if isAuth() && resource.data.teacherId == request.auth.uid;
      // Admins manage all salaries
      allow list, write: if isAdmin() && hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
      allow read, list, write: if isAdmin() && hasPermission('manage_cash_flow');
    }

    match /officialDocuments/{docId} {
      // Students can read their own documents
      allow read: if isAuth() && resource.data.studentId == request.auth.uid;
      // Admins can manage all documents
      allow list, write: if isAdmin() && hasPermission('manage_students');
    }

    match /attendances/{attendanceId} {
      // Teachers can read attendances for their courses.
      // Students can read their own attendance records.
      // Admins can read all.
      allow read, list: if isAuth();
      allow write: if isAdmin() && hasPermission('manage_attendance');
    }
  }
}
