rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return request.auth.token;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuth() && getUserData().role == 'student';
    }

    function isParent() {
      return isAuth() && getUserData().role == 'parent';
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isParent() 
             && token.childrenUids is map 
             && studentId in token.childrenUids;
    }

    function hasPermission(permission) {
        let token = getUserData();
        return isAdmin() && ((token.roleId == 'super_admin') || (token.permissions is map && permission in token.permissions));
    }

    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isTeacher() && token.assignedCourses is map && courseId in token.assignedCourses;
    }

    // =====================================================================
    // Users Collection
    // Roles: Admin (all), User (read own)
    // =====================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      allow list: if isAdmin();
      allow create: if hasPermission('manage_users') || hasPermission('manage_students');
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      allow delete: if hasPermission('manage_users') || hasPermission('manage_students');
    }

    // =====================================================================
    // Admin & Settings Collections
    // Roles: Admin only
    // =====================================================================
    match /adminRoles/{roleId} {
      allow read, write: if hasPermission('manage_roles');
    }

    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // Academic Structure
    // Roles: Admin (write), Authenticated users (read)
    // =====================================================================
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_course');
    }

    match /feeStructures/{feeId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_fees');
    }

    // =====================================================================
    // Grades Collection
    // Roles: Admin (all), Teacher (own courses), Student/Parent (own)
    // =====================================================================
    match /grades/{gradeId} {
      allow read: if isStudent() && resource.data.studentId == request.auth.uid
                   || isParentOf(resource.data.studentId)
                   || isTeacherOfCourse(resource.data.courseId)
                   || hasPermission('manage_grades');
      
      allow create, update, delete: if hasPermission('manage_grades');
    }

    // =====================================================================
    // Payments Collection
    // Roles: Admin (all), Student/Parent (own)
    // =====================================================================
    match /payments/{paymentId} {
      allow read: if isStudent() && resource.data.studentId == request.auth.uid
                  || isParentOf(resource.data.studentId)
                  || hasPermission('manage_tuition');

      allow create: if isUser(request.resource.data.studentId);
      
      allow update, delete: if hasPermission('manage_tuition');
    }
    
    // =====================================================================
    // Salary & Financial Collections
    // Roles: Admin (all), Teacher (read own)
    // =====================================================================
    match /teacherSalaries/{salaryId} {
      allow read: if (isTeacher() && resource.data.teacherId == request.auth.uid) 
                   || hasPermission('manage_salaries');

      allow write: if hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
      allow read, write: if hasPermission('manage_cash_flow');
    }
    
    // =====================================================================
    // Communication Collections
    // =====================================================================
    
    // Announcements: Admin (write), Authenticated (read)
    match /announcements/{announcementId} {
        allow read: if isAuth();
        allow create, update, delete: if isAdmin();
    }
    
    // Private Messages: Participants only
    match /private_messages/{messageId} {
        allow read, create: if isUser(request.resource.data.senderId) || isUser(request.resource.data.receiverId);
        allow update, delete: if false; // Messages are immutable
    }

    // =====================================================================
    // Official Documents
    // Roles: Admin (write), Student/Parent (read own)
    // = an==================================================================
    match /officialDocuments/{documentId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid)
                   || isParentOf(resource.data.studentId)
                   || hasPermission('manage_students');
                   
      allow create, update, delete: if hasPermission('manage_students');
    }

    // =====================================================================
    // Attendance
    // Roles: Admin (all), Teacher (read own courses)
    // =====================================================================
    match /attendances/{attendanceId} {
        allow read: if hasPermission('manage_attendance') || isTeacherOfCourse(resource.data.courseId);
        allow write: if hasPermission('manage_attendance');
    }
    
    // =====================================================================
    // QR Sessions (Secure)
    // Roles: Any (create), Admin (validate), User (complete)
    // =====================================================================
    match /qr_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['status','createdAt']) 
                    && request.resource.data.status == 'pending';

      allow read: if isAuth();

      allow update: if 
        // Admin validates the session, ensuring userId is not changed.
        (isAdmin() && request.resource.data.status == 'validated' 
                     && resource.data.userId == request.resource.data.userId) 
        || 
        // User completes their own session.
        (isUser(resource.data.userId) && request.resource.data.status == 'completed'
                                        && request.resource.data.userId == resource.data.userId);

      allow delete: if isAdmin();
    }
  }
}
