/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and aims to prevent unauthorized data access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Access is restricted to the owning user.
 * - /adminRoles/{roleId}: Stores admin roles and permissions. Access is unrestricted for prototyping.
 * - /announcements/{announcementId}: Stores school-wide announcements. Access is unrestricted for prototyping.
 * - /private_messages/{messageId}: Stores private messages between users. Access is unrestricted for prototyping.
 * - /courses/{courseId}: Stores course information. Access is unrestricted for prototyping.
 * - /grades/{gradeId}: Stores student grades for courses. Access is unrestricted for prototyping.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized data harvesting.
 * - Admin roles and general messages are unrestricted for prototyping.
 * - QR Session read access is granted to signed in users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles, allowing only the owning user to read and write their own data.
     * @path /users/{userId}
     * @allow (create) User with ID "user123" can create their profile if authenticated as "user123".
     * @allow (get) User with ID "user123" can read their profile if authenticated as "user123".
     * @allow (update) User with ID "user123" can update their profile if authenticated as "user123".
     * @allow (delete) User with ID "user123" can delete their profile if authenticated as "user123".
     * @deny (create) User with ID "user123" cannot create a profile for "user456".
     * @deny (get) User with ID "user123" cannot read the profile of "user456".
     * @principle Enforces document ownership for all read and write operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages admin roles. For prototyping purposes, read and write access is granted to all signed-in users.
     * @path /adminRoles/{roleId}
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Stores school-wide announcements. For prototyping purposes, read and write access is granted to all signed-in users.
     * @path /announcements/{announcementId}
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Stores private messages between users. For prototyping purposes, read and write access is granted to all signed-in users.
     * @path /private_messages/{messageId}
     */
    match /private_messages/{messageId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Stores course information. For prototyping purposes, read and write access is granted to all signed-in users.
     * @path /courses/{courseId}
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Stores student grades for courses. For prototyping purposes, read and write access is granted to all signed-in users.
     * @path /grades/{gradeId}
     */
    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

   /**
    * @description Stores temporary sessions for QR code login.
    * @path /qr_sessions/{sessionId}
    * @allow (get) Any signed-in user can read a QR session to validate it.
    * @deny (create) No one can create a qr_session document through direct client access (handled by backend).
    */
    match /qr_sessions/{sessionId} {
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    // Helper function to determine if the current user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to determine if the current user is the owner of the document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to determine if the current user is the existing owner of the document and the document exists.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}