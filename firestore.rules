rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // Helper Functions
    // =================================G================================
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
        // Super admin bypasses permission checks
        let userRole = getUserData(request.auth.uid).role;
        return isAuth() && userRole == 'admin';
    }

    function hasPermission(permission) {
      let userRole = getUserData(request.auth.uid);
      if (!('admin' in userRole)) {
        return false;
      }
      let roleId = userRole.admin.roleId;
      if (roleId == 'super_admin') {
        return true;
      }
      let rolePermissions = get(/databases/$(database)/documents/adminRoles/$(roleId)).data.permissions;
      return permission in rolePermissions;
    }
    
    function isTeacher() {
        return isAuth() && getUserData(request.auth.uid).role == 'teacher';
    }
    
    function isStudent() {
        return isAuth() && getUserData(request.auth.uid).role == 'student';
    }

    function isParent() {
      return isAuth() && getUserData(request.auth.uid).role == 'parent';
    }

    // =================================================================
    // Global & Structural Collections
    // =================================================================
    match /settings/system {
      allow read: if isAuth();
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }

    match /sectors/{sectorId} {
      allow read, list: if isAuth();
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }
    
    match /fields/{fieldId} {
      allow read, list: if isAuth();
      allow write: if isAdmin() && hasPermission('manage_admin_settings');
    }

    match /adminRoles/{roleId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin() && hasPermission('manage_roles');
    }
    
    match /feeStructures/{feeId} {
      allow read, list: if isAdmin() && hasPermission('manage_fees');
      allow write: if isAdmin() && hasPermission('manage_fees');
    }

    // =================================================================
    // User Data Collection
    // =================================================================
    match /users/{userId} {
      allow read: if isAdmin() 
                  || isUser(userId)
                  || resource.data.role == 'admin'
                  || resource.data.role == 'teacher';
      
      // Allow authenticated users to list only staff members for messaging/display purposes
      allow list: if isAuth() && request.query.where.to_list().size() == 1
                   && request.query.where.to_list()[0].field == "role"
                   && request.query.where.to_list()[0].op == "in"
                   && request.query.where.to_list()[0].value.hasAll(['teacher', 'admin']);

      allow create: if isAdmin() && hasPermission('manage_users') || hasPermission('manage_students');
      allow update: if (isAdmin() && (hasPermission('manage_users') || hasPermission('manage_students'))) || isUser(userId);
      allow delete: if isAdmin() && (hasPermission('manage_users') || hasPermission('manage_students'));
    }

    // =================================================================
    // Academic & Communication Collections
    // =================================================================
    match /courses/{courseId} {
      allow read, list: if isAdmin() 
                         || (isTeacher() && resource.data.teacherId == request.auth.uid)
                         || (isStudent() && getUserData(request.auth.uid).student.level == resource.data.level && (getUserData(request.auth.uid).student.fieldId == resource.data.fieldId || getUserData(request.auth.uid).student.sectorId == resource.data.sectorId))
                         || (isParent() && request.auth.uid in getUserData(resource.data.studentId).parent.childrenUids); // Complex for parents, better handled by client logic
      allow write: if isAdmin() && hasPermission('manage_course');
    }

    match /grades/{gradeId} {
      allow read, list: if isAdmin() 
                        || isUser(resource.data.studentId)
                        || (isTeacher() && resource.data.teacherId == request.auth.uid) // Needs teacherId on grade
                        || (isParent() && request.auth.uid in getUserData(resource.data.studentId).parent.childrenUids);
      allow write: if isAdmin() && hasPermission('manage_grades') || isTeacher();
    }
    
    match /attendances/{attendanceId} {
        allow read, write: if isAdmin() && hasPermission('manage_attendance') || isTeacher();
    }
    
    match /officialDocuments/{docId} {
        allow read: if isUser(resource.data.studentId) || isAdmin() || (isParent() && resource.data.studentId in getUserData(request.auth.uid).parent.childrenUids);
        allow write: if isAdmin() && hasPermission('manage_students');
    }

    // =================================================================
    // Financial Collections
    // =================================================================
    match /payments/{paymentId} {
        allow read, list: if isUser(resource.data.studentId) || isAdmin() || (isParent() && resource.data.studentId in getUserData(request.auth.uid).parent.childrenUids);
        allow create: if isAuth(); // student or parent can create
        allow update, delete: if isAdmin() && hasPermission('manage_tuition');
    }
    
    match /teacherSalaries/{salaryId} {
        allow read, list: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isAdmin() && hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
        allow read, list, write: if isAdmin() && hasPermission('manage_cash_flow');
    }
    
    // =================================================================
    // Messaging Collections
    // =================================================================
     match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /private_messages/{messageId} {
      allow read, create: if isAuth() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }
    
    match /qr_sessions/{sessionId} {
      allow read, write: if isAuth();
    }
  }
}