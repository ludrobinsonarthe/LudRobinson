rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // =============================================================
    // Helper Functions
    // =============================================================
    function isAuth() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return isAuth() && request.auth.token.role == 'teacher';
    }

    function isStudent() {
      return isAuth() && request.auth.token.role == 'student';
    }
    
    function isParent() {
        return isAuth() && request.auth.token.role == 'parent';
    }
    
    // Check if the user has a specific permission from their custom claims
    function hasPermission(permission) {
      return isAdmin() && request.auth.token.roleId in get(/databases/$(database)/documents/adminRoles/$(request.auth.token.roleId)).data.permissions;
    }
    
    // =============================================================
    // Public Collections (Read-only for all authenticated users)
    // =============================================================
    match /settings/system {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /sectors/{sectorId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
    
    match /fields/{fieldId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /adminRoles/{roleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =============================================================
    // Users Collection
    // =============================================================
    match /users/{userId} {
      // Admins can manage all users
      allow read, write: if isAdmin();
      
      // Users can read/update their own profile
      allow get, update: if isUser(userId);
      
      // Parents can read their children's profiles
      allow get: if isParent() && userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids;
    }

    // =============================================================
    // Private Messages
    // =============================================================
    match /private_messages/{messageId} {
      // Allow read/write if the user is the sender or receiver
      allow read, write: if isAuth() && (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);
    }
    
    // =============================================================
    // Announcements
    // =============================================================
    match /announcements/{announcementId} {
      // Admins can create/delete any announcement
      allow write: if isAdmin();
      
      // Any authenticated user can read announcements based on their role/ID
      allow read: if isAuth() && 
                    (request.resource.data.receiverId == 'all' || 
                     request.resource.data.receiverId == request.auth.token.role ||
                     request.resource.data.receiverId == request.auth.token.roleId);
    }
    
    // =============================================================
    // Grades
    // =============================================================
    match /grades/{gradeId} {
      // Admins can manage all grades
      allow read, write: if isAdmin();

      // Students can only read their own grades
      allow get: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Parents can read their children's grades
      allow get: if isParent() && request.resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids;
      
      // Teachers can only create/update grades for their assigned courses
      allow create, update: if isTeacher() && request.resource.data.courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacher.assignedCourses;
    }

    // =============================================================
    // Payments & Fees
    // =============================================================
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
      allow get: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow get: if isParent() && request.resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids;
    }
    
    match /feeStructures/{fsId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
    
    match /cashTransactions/{ctId} {
        allow read, write: if isAdmin();
    }
    
    // =============================================================
    // Teacher Salaries
    // =============================================================
    match /teacherSalaries/{salaryId} {
        allow read, write: if isAdmin();
        allow get: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }

    // =============================================================
    // Attendance
    // =============================================================
    match /attendances/{attId} {
        allow read, write: if isAdmin();
    }
    
    // =============================================================
    // Official Documents
    // =============================================================
     match /officialDocuments/{docId} {
      allow write: if isAdmin();
      allow read: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow read: if isParent() && request.resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids;
    }
    
    // =============================================================
    // QR Sessions
    // =============================================================
    match /qr_sessions/{sessionId} {
      // Anyone can create a session request
      allow create;
      // Any authenticated user can validate a session for another device
      allow update: if isAuth() && request.resource.data.status == 'validated';
      // The requesting device can read its own session status
      allow read: if request.resource.data.status == 'pending' || request.resource.data.status == 'validated';
      // The session should be cleaned up
      allow delete;
    }
  }
}
