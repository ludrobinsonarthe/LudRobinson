rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow authenticated users to list users, but not read them all without constraint
    match /users {
      allow list: if request.auth != null;
    }

    // Rules for a single user document
    match /users/{userId} {
      allow get: if request.auth != null; // Allow any authenticated user to get a specific user's profile
      allow write: if request.auth.uid == userId; // Allow a user to write only to their own profile
    }

    match /adminRoles/{roleId} {
      allow read: if request.auth != null; // Admins need to read roles
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; // Only admins can change roles
    }
    
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /private_messages/{messageId} {
        allow read, write: if request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId;
        allow create: if request.auth.uid == request.resource.data.senderId;
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /grades/{gradeId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    
    match /payments/{paymentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null; // Student or Parent can create a pending payment record
        allow update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /teacherSalaries/{salaryId} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /cashTransactions/{transactionId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /officialDocuments/{docId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /attendances/{attendanceId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /staffAttendances/{attendanceId} {
        allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /settings/system {
      allow read: if true; // Everyone can read system settings
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /sectors/{sectorId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /fields/{fieldId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /feeStructures/{fsId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
     match /qr_sessions/{sessionId} {
      allow get: if true; // Let anyone read a session doc to listen for changes
      allow create, update, delete: if request.auth != null; // Only authenticated users can write
    }
  }
}
