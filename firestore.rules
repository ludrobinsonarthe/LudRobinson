/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. User profiles are strictly
 * controlled by the owning user. Announcements are publicly readable but
 * writable only by authorized users.  Private messages are accessible only to
 * the sender and receiver.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /adminRoles/{roleId}: Stores admin roles and permissions.
 * - /announcements/{announcementId}: Stores school-wide announcements.
 * - /private_messages/{messageId}: Stores private messages between users.
 * - /courses/{courseId}: Stores course information.
 * - /grades/{gradeId}: Stores student grades for courses.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Admin roles can be created and managed only by admins. (Not explicitly enforced here due to lack of admin context)
 * - Announcements are publicly readable.
 * - Private messages are accessible only to the sender and receiver.
 * - Listing users is disallowed.
 *
 * Denormalization for Authorization:
 *  - The current design doesn't require denormalization. However, if roles are managed
 *    outside of the user document, consider denormalizing role information onto
 *    documents where role-based access is needed to avoid costly `get()` operations.
 *
 * Structural Segregation:
 *  - Private messages are stored in a separate collection (/private_messages) from
 *    announcements (/announcements) to allow for different read access patterns.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile.
     * @deny (create) if the user ID in the request does not match the authenticated user ID.
     * @deny (update, delete) if the user is not the owner of the profile and the document does not exist.
     * @deny (list) because listing all users is not permitted.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(userId);
      allow list: if false;

      // Write rules
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin roles.
     * @path /adminRoles/{roleId}
     * @allow (get, list) if true, open to all users.
     * @allow (create, update, delete) if false, preventing unauthorized modifications.
     * @principle Protects admin role definitions, but currently prevents any modifications.
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) if true, open to all users.
     * @allow (create, update, delete) if false, preventing unauthorized modifications.
     * @principle Allows public read access to announcements, but restricts writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to private messages between users.
     * @path /private_messages/{messageId}
     * @allow (get) if the user is either the sender or the receiver.
     * @allow (create) if the user is the sender.
     * @allow (update, delete) if false, preventing modifications.
     * @deny (list) to prevent unauthorized access to all messages.
     * @principle Restricts access to private messages to only the involved parties.
     */
    match /private_messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get, list) if true, open to all users.
     * @allow (create, update, delete) if false, preventing unauthorized modifications.
     * @principle Allows public read access to course information, but restricts writes.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to student grades.
     * @path /grades/{gradeId}
     * @allow (get) if the user is the student.
     * @allow (create, update, delete) if false, preventing unauthorized modifications.
     * @deny (list) to prevent unauthorized access to all grades.
     * @principle Restricts access to grades to only the student.
     */
    match /grades/{gradeId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to temporary QR code sessions.
     * @path /qr_sessions/{sessionId}
     * @allow (get, create, update) if the user is authenticated.
     * @allow (delete) if false, preventing unauthorized deletions.
     * @deny (list) to prevent unauthorized access to all sessions.
     * @principle Restricts access to QR sessions to authenticated users.
     */
    match /qr_sessions/{sessionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, create, update: if isSignedIn();
      allow delete: if false;
      allow list: if false;
    }
  }
}