rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
        return isAuth() && request.auth.token.role == 'teacher';
    }

    function hasPermission(permission) {
      return isAdmin() && request.auth.token.permissions.hasAny(permission);
    }
    
    function isParentOf(studentId) {
        let parentData = request.auth.token;
        return isAuth() && parentData.role == 'parent' &&
           parentData.parent != null &&
           studentId in parentData.parent.childrenUids;
    }

    // =====================================================================
    // Collections Rules
    // =====================================================================

    // Settings, Sectors, Fields: Publicly readable by any authenticated user
    match /{collectionName}/{docId} where collectionName in ['settings', 'sectors', 'fields', 'courses', 'adminRoles'] {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // Users: Granular access control
    match /users/{userId} {
      allow read: if isUser(userId) || hasPermission('manage_users');
      allow create: if hasPermission('manage_users');
      allow update: if isUser(userId) || hasPermission('manage_users');
      allow delete: if hasPermission('manage_users');
    }
    
    // Announcements: Read for specific roles, write only for admin
    match /announcements/{announcementId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_admin_settings'); // Or a more specific permission
    }

    // Private Messages: Only between sender and receiver
    match /private_messages/{messageId} {
        allow read, update, delete: if isAuth() && (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
    }

    // Grades: Read for student/parent/admin/teacher, write for teacher/admin
    match /grades/{gradeId} {
        allow read: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || hasPermission('manage_grades');
        allow create, update, delete: if hasPermission('manage_grades') || (isTeacher() && request.auth.uid == get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId);
    }
    
    // Payments: Read for student/parent, full access for finance admin
    match /payments/{paymentId} {
      allow read: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || hasPermission('manage_tuition');
      allow write: if hasPermission('manage_tuition');
    }

    // Official Documents: Read for student/parent, full access for admin
    match /officialDocuments/{docId} {
        allow read: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || hasPermission('manage_students');
        allow write: if hasPermission('manage_students');
    }
    
    // Teacher Salaries & Attendances: Only for admins with salary/attendance permissions
    match /{collectionName}/{docId} where collectionName in ['teacherSalaries', 'attendances'] {
        allow read, write: if hasPermission('manage_salaries') || hasPermission('manage_attendance');
    }
    
    // Cash Transactions: Only for admins with cash flow permissions
    match /cashTransactions/{transactionId} {
        allow read, write: if hasPermission('manage_cash_flow');
    }
    
    // Fee Structures: Read for any admin, write only for fee managers
    match /feeStructures/{feeId} {
        allow read: if isAdmin();
        allow write: if hasPermission('manage_fees');
    }
    
    // QR Sessions: Tightly controlled session validation
    match /qr_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['status', 'createdAt']) && request.resource.data.status == 'pending';
      allow read: if true;
      allow update: if (isAuth() && request.resource.data.status == 'validated') || (isAuth() && isUser(request.resource.data.userId) && request.resource.data.status == 'completed');
      allow delete: if isAdmin();
    }
  }
}
