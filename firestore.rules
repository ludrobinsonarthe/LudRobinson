/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for user profiles and restricts access to other collections based on role or explicit authorization. Data shape validation is relaxed for prototyping speed.
 *
 * @dataStructure
 * - /users/{userId}: Stores individual user profiles; owned by the user.
 * - /adminRoles/{roleId}: Stores admin roles and permissions; publicly readable but write-protected.
 * - /announcements/{announcementId}: Stores school-wide announcements; publicly readable, but write access is not defined.
 * - /private_messages/{messageId}: Stores private messages between users; access is not defined, defaulting to no access for all users.
 * - /courses/{courseId}: Stores course information; publicly readable, but write access is not defined.
 * - /grades/{gradeId}: Stores student grades; publicly readable, but write access is not defined.
 * - /qr_sessions/{sessionId}: Stores temporary QR code login sessions; no read or write access is defined.
 *
 * @keySecurityDecisions
 * - User profiles are strictly owned by the authenticated user.
 * - Admin roles are publicly readable but not writable through the client.
 * - Listing of user documents is disallowed for privacy.
 * - Ambiguous relationships (e.g., announcements, private messages, courses, grades, qr_sessions) default to no access.
 *
 * @denormalizationForAuthorization
 * - The rules do not rely on denormalization.
 *
 * @structuralSegregation
 * - The rules do not rely on structural segregation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with uid 'user123' can create their own profile.
     * @allow (get) User with uid 'user123' can read their own profile.
     * @allow (update) User with uid 'user123' can update their own profile.
     * @allow (delete) User with uid 'user123' can delete their own profile.
     * @deny (create) User with uid 'user456' cannot create a profile with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin role documents.
     * @path /adminRoles/{roleId}
     * @allow (get) Any user can read admin role details.
     * @deny (create) No client-side creation allowed.
     * @deny (update) No client-side updates allowed.
     * @deny (delete) No client-side deletion allowed.
     * @principle Restricts write access to admin role configurations.
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to announcement documents.
     * @path /announcements/{announcementId}
     * @allow (get) Any user can read announcements.
     * @deny (create) No client-side creation allowed.
     * @deny (update) No client-side updates allowed.
     * @deny (delete) No client-side deletion allowed.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to private message documents.
     * @path /private_messages/{messageId}
     * @deny (get) No user can read private messages.
     * @deny (create) No user can create private messages.
     * @deny (update) No user can update private messages.
     * @deny (delete) No user can delete private messages.
     */
    match /private_messages/{messageId} {
      allow get, list, create, update, delete: if false;
    }

    /**
     * @description Controls access to course documents.
     * @path /courses/{courseId}
     * @allow (get) Any user can read course information.
     * @deny (create) No user can create course information.
     * @deny (update) No user can update course information.
     * @deny (delete) No user can delete course information.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to grade documents.
     * @path /grades/{gradeId}
     * @allow (get) Any user can read grade information.
     * @deny (create) No user can create grade information.
     * @deny (update) No user can update grade information.
     * @deny (delete) No user can delete grade information.
     */
    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to QR session documents.
     * @path /qr_sessions/{sessionId}
     * @deny (get) No user can read qr_sessions information.
     * @deny (create) No user can create qr_sessions information.
     * @deny (update) No user can update qr_sessions information.
     * @deny (delete) No user can delete qr_sessions information.
     */
    match /qr_sessions/{sessionId} {
      allow get, list, create, update, delete: if false;
    }
  }
}