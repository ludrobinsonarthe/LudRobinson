/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and restricts
 * access to admin roles. Public read access is allowed for announcements,
 * but all other data requires authentication.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores individual user profiles.
 * - `/adminRoles/{roleId}`: Defines admin roles and their permissions.
 * - `/announcements/{announcementId}`: Contains school-wide announcements.
 * - `/private_messages/{messageId}`: Stores private messages between users.
 * - `/courses/{courseId}`: Contains course information.
 * - `/grades/{gradeId}`: Stores student grades for courses.
 * - `/qr_sessions/{sessionId}`: Stores temporary sessions for QR code login.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Admin role management is restricted.
 * - Public read access for announcements.
 * - Private messages are only accessible to sender and receiver.
 *
 * Denormalization for Authorization:
 *  - No denormalization is explicitly required based on the current schema, but the ruleset relies on the `userId` in the path `/users/{userId}` to match the `uid` field inside the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get, list, update, delete) Only the user themselves can read, update or delete their profile.
     * @deny (create) If the userId does not match the authenticated user's uid.
     * @deny (update, delete) If the document does not exist.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to admin roles and permissions.
     * @path /adminRoles/{roleId}
     * @allow (get) Authenticated users can read admin roles.
     * @deny (create, update, delete) Only admins with proper authorization can manage admin roles.
     * @principle Restricts access to admin role management.
     */
    match /adminRoles/{roleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder for admin role check (implementation needed)
      function isAdmin() {
        return false; // Replace with actual admin check logic
      }

      allow get: if isSignedIn();
      allow list: if false; // Admin role listing is not allowed.
      allow create: if false; // TODO: Add admin validation
      allow update: if false; // TODO: Add admin validation
      allow delete: if false; // TODO: Add admin validation
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) All users can read announcements.
     * @deny (create, update, delete) Only authorized users can create, update, or delete announcements.
     * @principle Allows public read access for announcements, restricts write access.
     */
    match /announcements/{announcementId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder for announcement creator check (implementation needed)
      function isAnnouncementCreator(announcementId) {
        return false; // Replace with actual creator check logic
      }

      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add creator validation
      allow update: if false; // TODO: Add creator validation
      allow delete: if false; // TODO: Add creator validation
    }

    /**
     * @description Controls access to private messages between users.
     * @path /private_messages/{messageId}
     * @allow (get) Only the sender or receiver can read the message.
     * @deny (create, update, delete) Only the sender can create, update, or delete their own messages.
     * @principle Enforces access control for private messages based on sender and receiver.
     */
    match /private_messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isSenderOrReceiver(messageId) {
        return isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      }

      function isSender(messageId) {
        return isSignedIn() && resource.data.senderId == request.auth.uid;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if false; // Listing private messages is not allowed.
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get, list) Authenticated users can read course information.
     * @deny (create, update, delete) Only authorized users can manage course information.
     * @principle Restricts access to course management.
     */
    match /courses/{courseId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Placeholder for course admin check (implementation needed)
      function isCourseAdmin(courseId) {
        return false; // Replace with actual admin check logic
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false; // TODO: Add course admin validation
      allow update: if false; // TODO: Add course admin validation
      allow delete: if false; // TODO: Add course admin validation
    }

    /**
     * @description Controls access to student grades for courses.
     * @path /grades/{gradeId}
     * @allow (get) Only the student or authorized users can read grades.
     * @deny (create, update, delete) Only authorized users can manage grades.
     * @principle Enforces access control for grades.
     */
    match /grades/{gradeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isStudentGrade(gradeId) {
        return isSignedIn() && resource.data.studentId == request.auth.uid;
      }

      // Placeholder for grade admin check (implementation needed)
      function isGradeAdmin(gradeId) {
        return false; // Replace with actual admin check logic
      }

      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isGradeAdmin(gradeId));
      allow list: if false; // Listing grades is not allowed.
      allow create: if false; // TODO: Add grade admin validation
      allow update: if false; // TODO: Add grade admin validation
      allow delete: if false; // TODO: Add grade admin validation
    }

    /**
     * @description Controls access to temporary QR code login sessions.
     * @path /qr_sessions/{sessionId}
     * @allow (get, create, update) Only the user associated with the session can access it.
     * @deny (delete) Deletion of QR sessions is disallowed.
     * @principle Enforces access control for temporary QR code login sessions.
     */
    match /qr_sessions/{sessionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isQrSessionOwner(sessionId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

       function isCreatingOwnQrSession(sessionId) {
          return isSignedIn() && request.resource.data.userId == request.auth.uid;
       }

      allow get: if isQrSessionOwner(sessionId);
      allow list: if false; // Listing qr_sessions is not allowed.
      allow create: if isCreatingOwnQrSession(sessionId);
      allow update: if isQrSessionOwner(sessionId);
      allow delete: if false;
    }
  }
}