rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for qr_sessions
    match /qr_sessions/{sessionId} {
      allow create: if true;
      allow read, delete: if isAuth() && (resource.data.userId == request.auth.uid || resource.data.creatorUid == request.auth.uid);
      allow update: if isAuth();
    }

    // Rules for users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && isOwner(userId);
      allow delete: if isAuth() && isOwner(userId);
    }
    
    // Rules for settings
    match /settings/system {
      allow read: if true;
      allow write: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for announcements
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for private messages
    match /private_messages/{messageId} {
      allow read, create: if isAuth() && (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);
      allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
    }

    // Rules for sectors
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for fields
    match /fields/{fieldId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for courses
    match /courses/{courseId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for adminRoles
    match /adminRoles/{roleId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for payments
    match /payments/{paymentId} {
        allow read: if isAuth();
        allow create: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for grades
    match /grades/{gradeId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for teacherSalaries
    match /teacherSalaries/{salaryId} {
         allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for cashTransactions
    match /cashTransactions/{transactionId} {
         allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for officialDocuments
    match /officialDocuments/{docId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for attendances
    match /attendances/{attendanceId} {
         allow read, write: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for staffAttendances
    match /staffAttendances/{attendanceId} {
         allow read, write: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

     // Rules for feeStructures
    match /feeStructures/{feeId} {
         allow read: if isAuth();
         allow write: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

  }
}
