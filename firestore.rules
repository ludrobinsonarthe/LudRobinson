rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read.
    // The application logic handles showing the correct data to the correct user.
    // This also allows other Firebase services (like Storage) to read data for their rules.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Allow users to create/update their own document
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow admins to write to most collections
    match /{collection}/{docId} {
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow anyone to create a private message (for student-to-teacher communication)
    match /private_messages/{messageId} {
      allow create: if request.auth != null;
    }
  }
}
