rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // =============================================
    // Helper Functions
    // =============================================
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    
    function isParent() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // =============================================
    // Public Collections (read-only for authenticated users)
    // =============================================
    match /settings/system {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if isAdmin(); // Sectors can be managed by admins
    }
    
    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if isAdmin(); // Fields can be managed by admins
    }

    match /courses/{courseId} {
        allow read: if isAuth();
        allow write: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
    }
    
    match /feeStructures/{feeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /adminRoles/{roleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // =============================================
    // Announcements
    // =============================================
    match /announcements/{announcementId} {
       allow read: if isAuth();
       allow create, update, delete: if isAdmin();
    }
    
    // =============================================
    // Private Messages
    // =============================================
     match /private_messages/{messageId} {
        allow read: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
        allow create: if isAuth() && (request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
    }
    
    // =============================================
    // Users Collection
    // =============================================
    match /users/{userId} {
      // Admins can manage all users.
      allow read, write: if isAdmin();
      
      // Users can read their own profile, and update certain fields.
      allow get: if isAuth();
      allow update: if isAuth() && isOwner(userId)
                    && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'phone', 'address', 'photoUrl']);
                     
      // Students and Teachers can be read by other authenticated users.
      allow list: if isAuth();
    }

    // =============================================
    // Student/Parent Specific Collections
    // =============================================
    match /grades/{gradeId} {
      allow read: if isAdmin() || (isAuth() && resource.data.studentId == request.auth.uid) 
                   || (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids)
                   || (isTeacher() && resource.data.courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacher.assignedCourses);
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    
    match /payments/{paymentId} {
       allow read: if isAdmin() || (isAuth() && resource.data.studentId == request.auth.uid)
                   || (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids);
       allow create: if isAuth();
       allow update, delete: if isAdmin();
    }
    
    match /officialDocuments/{docId} {
      allow read: if isAdmin() || (isAuth() && resource.data.studentId == request.auth.uid)
                   || (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parent.childrenUids);
      allow create, update, delete: if isAdmin();
    }
    
    // =============================================
    // Admin/Teacher Specific Collections
    // =============================================
    match /teacherSalaries/{salaryId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /cashTransactions/{transactionId} {
      allow read, write: if isAdmin();
    }
    
    match /attendances/{attendanceId} {
      allow read, write: if isAdmin() || isTeacher();
    }
    
    match /qr_sessions/{sessionId} {
      allow read, write: if isAuth();
    }
  }
}
