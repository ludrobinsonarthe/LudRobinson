rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      // In Firestore rules, the user's custom claims are on request.auth.token
      return request.auth.token;
    }

    function isRole(role) {
      return isAuth() && getUserData().role == role;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isRole('parent') && token.childrenUids is map && studentId in token.childrenUids;
    }
    
    function hasPermission(permission) {
        let token = getUserData();
        return isRole('admin') && 
               (token.roleId == 'super_admin' || (token.permissions is map && permission in token.permissions));
    }

    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isRole('teacher') && token.assignedCourses is map && courseId in token.assignedCourses;
    }

    // =====================================================================
    // Collections Rules
    // =====================================================================

    match /users/{userId} {
      // Allow reading your own user doc.
      // Allow reading any user doc if you are an admin.
      allow get: if isUser(userId) || hasPermission('manage_users');

      // Allow listing users ONLY if filtering for admin/teacher roles.
      // This is crucial for non-admins to be able to see teacher/admin names.
      allow list: if hasPermission('manage_users') || request.query.where.get('role', ['in', ['admin', 'teacher']]);
      
      // Allow creating users if you have the permission.
      allow create: if hasPermission('manage_users') || hasPermission('manage_students');
      
      // Allow updating your own profile, or any profile if you are an admin.
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      
      // Allow deleting users if you have the permission.
      allow delete: if hasPermission('manage_users') || hasPermission('manage_students');
    }

    match /settings/{settingId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_admin_settings');
    }

    match /adminRoles/{roleId} {
      allow read, list: if isRole('admin');
      allow write: if hasPermission('manage_roles');
    }
    
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    
    match /courses/{courseId} {
      function isStudentInCourse() {
        let studentData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return isRole('student') 
               && resource.data.level == studentData.student.level
               && (resource.data.fieldId == studentData.student.fieldId || resource.data.sectorId == studentData.student.sectorId);
      }
      
      function isParentOfStudentInCourse() {
          let token = getUserData();
          if (!isRole('parent') || !(token.childrenUids is list) || token.childrenUids.size() == 0) {
              return false;
          }
          let studentDoc = get(/databases/$(database)/documents/users/$(token.childrenUids[0])).data;
          return resource.data.level == studentDoc.student.level 
              && (resource.data.fieldId == studentDoc.student.fieldId || resource.data.sectorId == studentDoc.student.sectorId);
      }

      allow get: if isRole('admin') || isTeacherOfCourse(courseId) || isStudentInCourse() || isParentOfStudentInCourse();
      allow list: if hasPermission('manage_course'); // Only admins can list all courses
      allow create, update, delete: if hasPermission('manage_course');
    }

    match /feeStructures/{feeId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_fees');
    }

    match /grades/{gradeId} {
      allow get: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || isTeacherOfCourse(resource.data.courseId) || hasPermission('manage_grades');
      allow list: if hasPermission('manage_grades'); // Only admin can list all grades
      allow create, update, delete: if hasPermission('manage_grades');
    }

    match /payments/{paymentId} {
      allow get, list, create: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || hasPermission('manage_tuition');
      allow update, delete: if hasPermission('manage_tuition');
    }
    
    match /teacherSalaries/{salaryId} {
      allow read: if hasPermission('manage_salaries') || isUser(resource.data.teacherId);
      allow list, create, update, delete: if hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
      allow read: if hasPermission('manage_cash_flow');
      allow list, create, update, delete: if hasPermission('manage_cash_flow');
    }

    match /attendances/{attendanceId} {
      allow read: if isAuth();
      allow list, create, update, delete: if hasPermission('manage_attendance');
    }

    match /officialDocuments/{docId} {
        allow get, list, create: if isUser(resource.data.studentId) || isParentOf(resource.data.studentId) || hasPermission('manage_students');
        allow update, delete: if hasPermission('manage_students');
    }

    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isRole('admin');
    }

    match /private_messages/{messageId} {
      allow read, write: if isUser(request.resource.data.senderId) || isUser(request.resource.data.receiverId)
                         || isUser(resource.data.senderId) || isUser(resource.data.receiverId);
    }
     match /qr_sessions/{sessionId} {
      allow read, write: if true; // Open for demo purposes
    }
  }
}
