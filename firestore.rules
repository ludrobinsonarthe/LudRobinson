rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection
    match /users {
      // Allow authenticated users to list users
      allow list: if request.auth != null;
      // Disallow writing to the collection directly for security
      allow write: if false;
    }
    
    // Rules for individual user documents
    match /users/{userId} {
      // Allow authenticated users to read any user profile
      allow read: if request.auth != null;
      // Allow users to write ONLY to their own profile
      allow write: if request.auth.uid == userId;
    }

    // Rules for admin roles
    match /adminRoles/{roleId} {
      allow read: if request.auth != null;
      // Allow write only if the user has the 'manage_roles' permission (to be implemented)
      allow write: if request.auth != null; 
    }
    
    // Rules for announcements
    match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null; // Simplified for now
    }

    // Rules for private messages
    match /private_messages/{messageId} {
        // Users can only read/write messages where they are the sender or receiver
        allow read, write: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }
    
    // Rules for courses
    match /courses/{courseId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null; // Simplified for now
    }
    
    // Rules for grades
    match /grades/{gradeId} {
        // Students can read their own grades, admins/teachers can read all.
        allow read: if request.auth != null;
        // Admins/teachers can write grades
        allow write: if request.auth != null; // Simplified for now
    }

    // Rules for QR sessions
    match /qr_sessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }

    // Allow admins to read/write all other collections for now
    match /{document=**} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
