/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for user profiles and restricts access to other collections based on role or explicit authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /adminRoles/{roleId}: Defines admin roles and permissions.
 * - /announcements/{announcementId}: Stores school-wide announcements.
 * - /private_messages/{messageId}: Stores private messages between users.
 * - /courses/{courseId}: Stores course information.
 * - /grades/{gradeId}: Stores student grades for courses.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data under /users/{userId}.
 * - Admin roles are read-only for now (no create, update, or delete).
 * - Announcements are publicly readable but only writable by admins.
 * - Private messages can only be read/written by the sender or receiver.
 * - QR sessions are only readable by the user who created the session.
 * - Listing of users is denied to prevent information disclosure.
 * - Schema validation is relaxed in this prototyping phase to allow for rapid iteration.
 *
 * Denormalization for Authorization:
 * - The 'Message' entity has senderId and receiverId, which are used to authorize read/write access to private messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profiles. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the uid matches the document id.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own profile if the uid matches the document id.
     * @deny (create) - User attempts to create a profile with a different uid.
     * @deny (get, update, delete) - User attempts to read, update, or delete another user's profile.
     * @principle Enforces document ownership for all write operations.
     */
    match /users/{userId} {
      // isSignedIn() function defined below ensures that only authenticated users can attempt any operation.
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Grants read-only access to admin roles. No create, update, or delete allowed.
     * @path /adminRoles/{roleId}
     * @allow (get, list) - Any authenticated user can read admin roles.
     * @deny (create, update, delete) - No one can create, update, or delete admin roles.
     * @principle Restricts write access to admin roles.
     */
    match /adminRoles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to announcements, but restricts write access to admins only.
     * @path /announcements/{announcementId}
     * @allow (get, list) - Any user can read announcements.
     * @allow (create) - Only admins can create announcements.
     * @allow (update, delete) - Only admins can update or delete announcements.
     * @deny (create, update, delete) - Non-admin users cannot create, update, or delete announcements.
     * @principle Enforces public read access with admin-only writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Grants access to private messages. Only the sender or receiver can read or write a message.
     * @path /private_messages/{messageId}
     * @allow (get) - Sender or receiver can read the message.
     * @allow (create) - Authenticated user can create a message.
     * @allow (update) - Only the sender can update the message.
     * @allow (delete) - Only the sender can delete the message.
     * @deny (get) - A user who is neither the sender nor the receiver attempts to read the message.
     * @principle Restricts access to private messages to sender and receiver only.
     */
    match /private_messages/{messageId} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && isExistingSender();
      allow delete: if isSignedIn() && isExistingSender();

      function isExistingSender() {
        return resource != null && resource.data.senderId == request.auth.uid;
      }
    }

    /**
     * @description Grants read access to courses for all users.  Write access is not defined and defaults to denied.
     * @path /courses/{courseId}
     * @allow (get, list) - Any user can read courses.
     * @deny (create, update, delete) - No one can create, update or delete courses (explicitly, to be revisited).
     * @principle Grants public read access to course information.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants read access to grades for all users. Write access is not defined and defaults to denied.
     * @path /grades/{gradeId}
     * @allow (get, list) - Any user can read grades.
     * @deny (create, update, delete) - No one can create, update or delete grades (explicitly, to be revisited).
     * @principle Grants public read access to grade information.
     */
    match /grades/{gradeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants access to QR sessions. The user who created the session can read, update, and delete it.
     * @path /qr_sessions/{sessionId}
     * @allow (get) - The user who created the session can read the session.
     * @allow (create) - Any authenticated user can create qr session.
     * @allow (update, delete) - Only the session owner can update or delete.
     * @deny (get) - A user who did not create the session attempts to read the session.
     * @principle Restricts access to QR sessions to the session owner.
     */
    match /qr_sessions/{sessionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingQrSessionOwner();
      allow delete: if isSignedIn() && isExistingQrSessionOwner();

      function isExistingQrSessionOwner() {
        return resource != null && resource.data.userId == request.auth.uid;
      }
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
  }
}