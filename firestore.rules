rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return request.auth.token;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }
    
    function isSuperAdmin() {
      return isAdmin() && getUserData().roleId == 'super_admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuth() && getUserData().role == 'student';
    }

    function isParent() {
      return isAuth() && getUserData().role == 'parent';
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isParent() 
             && token.childrenUids is map 
             && studentId in token.childrenUids;
    }

    function hasPermission(permission) {
      let token = getUserData();
      return isSuperAdmin() || (isAdmin() && token.permissions is map && permission in token.permissions);
    }

    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isTeacher() && token.assignedCourses is map && courseId in token.assignedCourses;
    }
    
    // =====================================================================
    // Global Collections (Sectors, Fields) - Readable by all authenticated users
    // =====================================================================
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    
    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // Users Collection
    // =====================================================================
    match /users/{userId} {
      allow get: if isAuth();
      allow list: if hasPermission('manage_students') || hasPermission('manage_users');
      allow create: if hasPermission('manage_users') || hasPermission('manage_students');
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      allow delete: if hasPermission('manage_users') || hasPermission('manage_students');
    }

    // =====================================================================
    // Admin & Settings Collections
    // =====================================================================
    match /adminRoles/{roleId} {
      allow read: if isAdmin();
      allow write: if hasPermission('manage_roles');
    }

    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // Academic Structure
    // =====================================================================
    match /courses/{courseId} {
      allow read: if isAuth(); // Further checks inside specific queries.
      allow write: if hasPermission('manage_course');
    }

    match /feeStructures/{feeId} {
      allow read: if isAdmin();
      allow write: if hasPermission('manage_fees');
    }

    // =====================================================================
    // Grades Collection
    // =====================================================================
    match /grades/{gradeId} {
      allow read: if (
        isStudent() && resource.data.studentId == request.auth.uid
      ) || isParentOf(resource.data.studentId) || isTeacherOfCourse(resource.data.courseId) || isAdmin();
      allow write: if isTeacherOfCourse(request.resource.data.courseId) || hasPermission('manage_grades');
    }

    // =====================================================================
    // Financial Collections
    // =====================================================================
    match /payments/{paymentId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) || isParentOf(resource.data.studentId) || hasPermission('manage_tuition');
      allow create: if isAuth(); // Student can submit, admin creates directly
      allow update: if hasPermission('manage_tuition');
      allow delete: if hasPermission('manage_tuition');
    }
    
    match /cashTransactions/{transactionId} {
      allow read: if hasPermission('manage_cash_flow');
      allow write: if hasPermission('manage_cash_flow');
    }

    match /teacherSalaries/{salaryId} {
      allow read: if hasPermission('manage_salaries') || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if hasPermission('manage_salaries');
    }
    
    // =====================================================================
    // Communication & Documents
    // =====================================================================
    match /announcements/{announcementId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_admin_settings');
    }

    match /private_messages/{messageId} {
      allow read, write: if (
        (isUser(request.resource.data.senderId) && isAuth()) || 
        (isUser(resource.data.receiverId) && isAuth())
      );
    }
    
    match /officialDocuments/{docId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) || isParentOf(resource.data.studentId) || isAdmin();
      allow write: if hasPermission('manage_students');
    }
    
    // =====================================================================
    // Attendance & QR Sessions
    // =====================================================================
    match /attendances/{attendanceId} {
        allow read, write: if hasPermission('manage_attendance');
    }

    match /qr_sessions/{sessionId} {
      allow read: if isAuth();
      allow create: if request.resource.data.status == 'pending';
      allow update: if (isAdmin() && request.resource.data.status == 'validated' && request.resource.data.userId == resource.data.userId) || (isUser(resource.data.userId) && request.resource.data.status == 'completed');
      allow delete: if isAdmin();
    }
  }
}