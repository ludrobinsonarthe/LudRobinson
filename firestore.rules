rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if the user has an 'admin' role in their user document.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Global read access for authenticated users, write access for admins.
    // This allows the app to function while securing write operations.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Specific write rules
    match /users/{userId} {
      allow update: if request.auth.uid == userId || isAdmin(); // Users can update their own profile, admins can too.
      allow create, delete: if isAdmin();
    }

    // Admins have write access to all other collections
    match /adminRoles/{docId} { allow write: if isAdmin(); }
    match /courses/{docId} { allow write: if isAdmin(); }
    match /feeStructures/{docId} { allow write: if isAdmin(); }
    match /payments/{docId} { allow write: if isAdmin(); }
    match /teacherSalaries/{docId} { allow write: if isAdmin(); }
    match /cashTransactions/{docId} { allow write: if isAdmin(); }
    match /grades/{docId} { allow write: if isAdmin(); }
    match /announcements/{docId} { allow write: if isAdmin(); }
    match /private_messages/{docId} { 
      allow create: if request.auth.uid == request.resource.data.senderId;
      allow read, update, delete: if request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId;
    }
    match /attendances/{docId} { allow write: if isAdmin(); }
    match /staffAttendances/{docId} { allow write: if isAdmin(); }
    match /officialDocuments/{docId} { allow write: if isAdmin(); }
    match /settings/{docId} { allow write: if isAdmin(); }
    match /sectors/{docId} { allow write: if isAdmin(); }
    match /fields/{docId} { allow write: if isAdmin(); }
  }
}
