rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // Helper Functions
    // =====================================================================
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isRole(role) {
      return isAuth() && request.auth.token.role == role;
    }
    
    function hasPermission(permission) {
      return isAdmin() && permission in request.auth.token.permissions;
    }

    function isParentOf(studentId) {
      return isAuth() && request.auth.token.role == 'parent' 
             && request.auth.token.childrenUids != null
             && studentId in request.auth.token.childrenUids;
    }

    // =====================================================================
    // Public / Semi-Public Collections
    // =====================================================================
    
    match /settings/{docId} {
        allow read: if isAuth(); // Accessible by any logged-in user
        allow write: if hasPermission('manage_admin_settings');
    }
    
    match /sectors/{sectorId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_admin_settings');
    }

    match /fields/{fieldId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_admin_settings');
    }

    match /courses/{courseId} {
        allow read: if isAuth();
        allow write: if hasPermission('manage_course');
    }
    
    match /feeStructures/{feeId} {
        allow read: if hasPermission('manage_fees');
        allow write: if hasPermission('manage_fees');
    }

    // =====================================================================
    // User Data & Profiles
    // =====================================================================

    match /users/{userId} {
      allow read: if isUser(userId) || hasPermission('manage_students') || hasPermission('manage_users');
      allow create: if hasPermission('manage_students') || hasPermission('manage_users');
      allow update: if isUser(userId) || hasPermission('manage_students') || hasPermission('manage_users');
      allow delete: if hasPermission('manage_students') || hasPermission('manage_users');
    }

    match /adminRoles/{roleId} {
        allow read: if hasPermission('manage_roles');
        allow write: if hasPermission('manage_roles');
    }

    // =====================================================================
    // Student & Parent Specific Data
    // =====================================================================

    match /grades/{gradeId} {
        allow create: if hasPermission('manage_grades');
        allow read, update: if (isUser(resource.data.studentId) || isParentOf(resource.data.studentId)) 
                               || hasPermission('manage_grades');
        allow delete: if hasPermission('manage_grades');
    }

    match /payments/{paymentId} {
        allow create: if isUser(request.resource.data.studentId) || hasPermission('manage_tuition');
        allow read, update: if (isUser(resource.data.studentId) || isParentOf(resource.data.studentId)) 
                               || hasPermission('manage_tuition');
        allow delete: if hasPermission('manage_tuition');
    }

    match /officialDocuments/{docId} {
        allow create: if hasPermission('manage_students');
        allow read: if (isUser(resource.data.studentId) || isParentOf(resource.data.studentId)) 
                       || hasPermission('manage_students');
        allow delete: if hasPermission('manage_students');
    }

    // =====================================================================
    // School-wide data
    // =====================================================================
    
    match /attendances/{attendanceId} {
        allow read, write: if hasPermission('manage_attendance');
    }

    match /teacherSalaries/{salaryId} {
        allow read, write: if hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
        allow read, write: if hasPermission('manage_cash_flow');
    }

    // =====================================================================
    // Messaging & Announcements
    // =====================================================================

    match /announcements/{annId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
    
    match /private_messages/{messageId} {
      allow read, create: if isAuth() && 
                           (request.resource.data.senderId == request.auth.uid || 
                            request.resource.data.receiverId == request.auth.uid || 
                            isAdmin());
      allow update, delete: if isAuth() && 
                              (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // =====================================================================
    // QR Code Login Sessions
    // =====================================================================

    match /qr_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['status','createdAt']) && request.resource.data.status == 'pending';
      allow read: if isAuth();
      allow update: if (isAuth() && request.resource.data.status == 'validated') || (isUser(request.resource.data.userId) && request.resource.data.status == 'completed');
      allow delete: if isAdmin();
    }
  }
}