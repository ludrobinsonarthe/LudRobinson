/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and restricts
 * access to admin roles. Public read access is granted for announcements and
 * courses, while private messages and grades are restricted to relevant users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /adminRoles/{roleId}: Stores admin roles and permissions.
 * - /announcements/{announcementId}: Stores school-wide announcements.
 * - /private_messages/{messageId}: Stores private messages between users.
 * - /courses/{courseId}: Stores course information.
 * - /grades/{gradeId}: Stores student grades for courses.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Listing of users is disallowed to prevent information harvesting.
 * - Announcements and courses are publicly readable.
 * - Private messages are only accessible to the sender and receiver.
 * - Grades are only accessible to the student and potentially teachers/admins (currently only student).
 * - Admin role management is restricted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) - User with uid 'user123' can create their own profile document.
     * @allow (get, update, delete) - User with uid 'user123' can read, update, or delete their own profile document.
     * @deny (create) - User with uid 'user456' cannot create a profile document for 'user123'.
     * @deny (get, update, delete) - User with uid 'user456' cannot read, update, or delete the profile document for 'user123'.
     * @deny (list) - No one can list all users.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to admin role data.
     * @path /adminRoles/{roleId}
     * @allow (get, list) - Anyone can read admin roles.
     * @deny (create, update, delete) - Only authenticated users can create, update, or delete admin roles.
     * @principle Restricts modification of admin roles.
     */
    match /adminRoles/{roleId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) - Anyone can read announcements.
     * @deny (create, update, delete) - Only authenticated users can create, update, or delete announcements.
     * @principle Allows public read access for announcements.
     */
    match /announcements/{announcementId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() == true;
    }

    /**
     * @description Controls access to private messages between users.
     * @path /private_messages/{messageId}
     * @allow (get) - User with uid 'user123' can read a message if they are the sender or receiver.
     * @allow (create) - User with uid 'user123' can create a message where they are the sender.
     * @deny (get) - User with uid 'user456' cannot read a message between 'user123' and 'user789'.
     * @deny (list) - No one can list all private messages.
     * @principle Restricts access to messages to the sender and receiver.
     */
    match /private_messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSenderOrReceiver() {
          return request.auth.uid in [resource.data.senderId, resource.data.receiverId];
      }
      allow get: if isSignedIn() && isSenderOrReceiver();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get, list) - Anyone can read course information.
     * @deny (create, update, delete) - Only authenticated users can create, update, or delete courses.
     * @principle Allows public read access for course information.
     */
    match /courses/{courseId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() == true;
    }

    /**
     * @description Controls access to student grades for courses.
     * @path /grades/{gradeId}
     * @allow (get) - User with uid 'student123' can read their own grade.
     * @deny (get) - User with uid 'student456' cannot read 'student123's grade.
     * @deny (list) - No one can list all grades.
     * @principle Restricts access to grades to the student.
     */
    match /grades/{gradeId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isStudent() {
        return request.auth.uid == resource.data.studentId;
      }
      allow get: if isSignedIn() && isStudent();
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to temporary QR code login sessions.
     * @path /qr_sessions/{sessionId}
     * @allow (get) - Anyone can read the QR session.
     * @deny (create, update, delete) - Only authenticated users can create, update, or delete sessions.
     */
    match /qr_sessions/{sessionId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if true;
        allow list: if false;
        allow create, update, delete: if isSignedIn() == true;
    }
  }
}