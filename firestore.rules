rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, delete) - User with matching UID can create, update, or delete their own profile.
     * @allow (get, list) - User with matching UID can get their own profile.
     * @deny (create) - User attempts to create a profile with a different UID.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Restricts access to admin roles.  No user should be able to create, update, or delete these.
     * @path /adminRoles/{roleId}
     * @allow (get, list) - Any signed-in user can read admin roles.
     * @deny (create, update, delete) - No one can create, update, or delete admin roles.
     * @principle Prevents unauthorized modification of admin roles.
     */
    match /adminRoles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read announcements, but restricts creation, updates, and deletion.
     * @path /announcements/{announcementId}
     * @allow (get, list) - Anyone can read announcements.
     * @deny (create, update, delete) - No one can create, update, or delete announcements (TODO: Implement admin role check).
     */
    match /announcements/{announcementId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false; // TODO: Implement admin role check
    }

    /**
     * @description Allows only the sender and receiver to access private messages.
     * @path /private_messages/{messageId}
     * @allow (get) - The user is either the sender or receiver of the message.
     * @allow (list) - The user is either the sender or receiver of the message.
     * @allow (create) - The user is the sender of the message.
     * @deny (update, delete) - No one can update or delete messages (to ensure auditability).
     * @deny (get, list) - The user is not the sender or receiver of the message.
     * @principle Implements shared access for private messages.
     */
    match /private_messages/{messageId} {
      function isParticipant(senderId, receiverId) {
        return request.auth.uid == senderId || request.auth.uid == receiverId;
      }

      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read course information.
     * @path /courses/{courseId}
     * @allow (get, list) - Anyone can read course information.
     * @deny (create, update, delete) - No one can create, update, or delete courses (TODO: Implement admin/teacher role check).
     * @principle Grants public read access to course data.
     */
    match /courses/{courseId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false; // TODO: Implement admin/teacher role check
    }

    /**
     * @description Allows students to read their own grades.
     * @path /grades/{gradeId}
     * @allow (get) - The user is the student associated with the grade.
     * @allow (list) - The user is the student associated with the grade.
     * @deny (create, update, delete) - No one can create, update, or delete grades (TODO: Implement teacher role check).
     * @deny (get, list) - The user is not the student associated with the grade.
     * @principle Restricts grade access to the student.
     */
    match /grades/{gradeId} {
      function isStudent(studentId) {
        return request.auth.uid == studentId;
      }
      allow get: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false; // TODO: Implement teacher role check
    }

    /**
     * @description Allows access to QR sessions for the associated user.
     * @path /qr_sessions/{sessionId}
     * @allow (get) - The user is the owner of the QR session.  This was the source of the original error.
     * @deny (list) - Listing QR sessions is not allowed.
     * @deny (create, update, delete) - Creation, updating, and deletion are not allowed (TODO: Implement backend logic).
     * @principle Restricts QR session access to the owner.
     */
    match /qr_sessions/{sessionId} {
       function isSessionOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create: if false; // TODO: Implement backend logic for creating QR sessions.
      allow update: if false; // TODO: Implement backend logic for updating QR sessions.
      allow delete: if false; // TODO: Implement backend logic for deleting QR sessions.
    }
  }
}