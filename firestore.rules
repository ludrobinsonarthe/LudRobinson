rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      // In security rules, custom claims are on request.auth.token, not a function call
      return request.auth.token;
    }
    
    function getUserDoc(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuth() && getUserData().role == 'student';
    }

    function isParent() {
      return isAuth() && getUserData().role == 'parent';
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isParent() 
             && token.childrenUids is list
             && studentId in token.childrenUids;
    }
    
    function hasPermission(permission) {
      let token = getUserData();
      // Super admin has all permissions
      if (isAdmin() && token.roleId == 'super_admin') {
        return true;
      }
      return isAdmin() && token.permissions is list && permission in token.permissions;
    }

    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isTeacher() && token.assignedCourses is list && courseId in token.assignedCourses;
    }

    // =====================================================================
    // Global Collections (Readable by all authenticated users)
    // =====================================================================
     match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    
    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // Users Collection
    // =====================================================================
    match /users/{userId} {
      // Admins can read any user profile.
      // Non-admins can only read profiles of teachers and other admins.
      // Any user can read their own profile.
      allow get: if hasPermission('manage_users') 
                  || (isAuth() && (getUserDoc(userId).role == 'admin' || getUserDoc(userId).role == 'teacher'))
                  || isUser(userId);
      
      // Only admins can list users, but this is implicitly handled by hasPermission on client queries
      allow list: if hasPermission('manage_users');

      // Admins can create users.
      allow create: if hasPermission('manage_users') || hasPermission('manage_students');
      
      // A user can update their own profile, or an admin can update any profile.
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      
      // Admins can delete users.
      allow delete: if hasPermission('manage_users') || hasPermission('manage_students');
    }

    // =====================================================================
    // Admin & Structure Collections
    // =====================================================================
    match /adminRoles/{roleId} {
      allow read, write: if hasPermission('manage_roles');
    }

    match /feeStructures/{feeId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_fees');
    }

    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_course');
    }

    // =====================================================================
    // Grades Collection
    // =====================================================================
    match /grades/{gradeId} {
      allow read: if isStudent() && resource.data.studentId == request.auth.uid
                     || isParentOf(resource.data.studentId)
                     || isTeacherOfCourse(resource.data.courseId)
                     || hasPermission('manage_grades');
      allow create, update, delete: if hasPermission('manage_grades') || isTeacherOfCourse(request.resource.data.courseId);
    }
    
    // =====================================================================
    // Payments & Finance Collections
    // =====================================================================
    match /payments/{paymentId} {
        allow read: if (isStudent() && resource.data.studentId == request.auth.uid)
                       || isParentOf(resource.data.studentId)
                       || hasPermission('manage_tuition');
        allow create: if (isStudent() && request.resource.data.studentId == request.auth.uid) 
                         || isParentOf(request.resource.data.studentId)
                         || hasPermission('manage_tuition');
        allow update, delete: if hasPermission('manage_tuition');
    }

    match /teacherSalaries/{salaryId} {
        allow read, create, update, delete: if hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
        allow read, create, update, delete: if hasPermission('manage_cash_flow');
    }

    // =====================================================================
    // Communication & Documents
    // =====================================================================
    match /announcements/{announcementId} {
        // Any authenticated user can read announcements matching their role/group.
        allow read: if isAuth();
        // Only admins can create, update or delete announcements.
        allow write: if hasPermission('manage_admin_settings');
    }
    
    match /private_messages/{messageId} {
        // A user can read a message if they are the sender or the receiver.
        allow read: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
        // A user can create a message if they are the sender.
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        // Messages are immutable once sent.
        allow update, delete: if false;
    }

    match /officialDocuments/{docId} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) 
                     || isParentOf(resource.data.studentId)
                     || hasPermission('manage_students');
      allow create, delete: if hasPermission('manage_students');
    }
    
    // =====================================================================
    // Attendance Collection
    // =====================================================================
    match /attendances/{attendanceId} {
        allow read, write: if hasPermission('manage_attendance');
    }
  }
}
