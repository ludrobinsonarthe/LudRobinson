rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isRole(role) {
      let userRole = getUserData(request.auth.uid).role;
      return isSignedIn() && userRole == role;
    }
    
    // Admins can be identified by their role in their own user document.
    function isAdmin() {
      return isRole('admin');
    }

    // Rules for 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own user document (e.g. on first sign-up)
      // Admins can create any user document
      allow create: if isSignedIn();
      
      // Users can read their own document.
      // Admins can read any user document.
      allow get: if isUser(userId) || isAdmin();
      
      // Users can update their own document.
      // Admins can update any user document.
      allow update: if isUser(userId) || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
      
      allow list: if isAdmin();
    }
    
    // Rules for collections that admins manage fully
    match /{collection}/{docId} where collection in ['adminRoles', 'cashTransactions', 'teacherSalaries', 'feeStructures'] {
      allow read, write: if isAdmin();
    }
    
    // Rules for public-readable data
     match /{collection}/{docId} where collection in ['settings', 'sectors', 'fields', 'courses'] {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Announcements (messages collection, type announcement)
    match /messages/{messageId} {
        // Any signed-in user can read announcements
        allow get: if isSignedIn() && resource.data.type == 'announcement';
        allow list: if isSignedIn() && resource.data.type == 'announcement';

        // Private messages
        allow read, write: if isSignedIn() 
                        && resource.data.type == 'private'
                        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
        
        // Admins can create/update/delete any message
        allow write: if isAdmin();
    }

    // Students, parents, teachers, and admins can access grades
    match /grades/{gradeId} {
        allow read: if isSignedIn() && 
                    (isUser(resource.data.studentId) // student can see their own grade
                    || getUserData(request.auth.uid).parent.childrenUids.hasAny([resource.data.studentId]) // parent can see child's grade
                    || isUser(get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId) // teacher of the course can see it
                    || isAdmin()); // admin can see all
        allow write: if isAdmin() || isUser(get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId);
    }
    
    // Payments
    match /payments/{paymentId} {
       allow read: if isSignedIn() && 
                    (isUser(resource.data.studentId) 
                    || getUserData(request.auth.uid).parent.childrenUids.hasAny([resource.data.studentId])
                    || isAdmin());
        allow create: if isSignedIn(); // Students can create payment records
        allow update, delete: if isAdmin();
    }

    // Official Documents
    match /officialDocuments/{docId} {
        allow read: if isSignedIn() && 
                    (isUser(resource.data.studentId)
                    || getUserData(request.auth.uid).parent.childrenUids.hasAny([resource.data.studentId])
                    || isAdmin());
        allow write: if isAdmin();
    }
    
    // Attendances
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isRole('teacher');
    }
    
    // Session sharing for QR code login
    match /qr_sessions/{sessionId} {
      allow read, create;
      allow update: if isSignedIn();
    }
  }
}
