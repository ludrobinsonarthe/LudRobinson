rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to user profile data to the owner (user themselves) and admins.
     * @path /users/{userId}
     * @allow (read, write) if isSignedIn() && (request.auth.uid == userId || isAdmin());
     * @deny (read, write) if !isSignedIn() || request.auth.uid != userId;
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // User listing is not allowed

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Stores admin roles and permissions. Only admins can create, update, or delete roles. All signed in users can read.
     * @path /adminRoles/{roleId}
     * @allow (get, list) if isSignedIn();
     * @allow (create, update, delete) if isSignedIn() && isAdmin();
     * @deny (create, update, delete) if !isAdmin();
     * @principle Restricts role management to admins.
     */
    match /adminRoles/{roleId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Stores school-wide announcements. Anyone can read announcements, but only admins can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list) if true;
     * @allow (create, update, delete) if isSignedIn() && isAdmin();
     * @deny (create, update, delete) if !isAdmin();
     * @principle Allows public read access but restricts write access to admins.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Stores private messages between users. Only the sender and receiver can read a message. Only the sender can create a message. No one can update or delete messages.
     * @path /private_messages/{messageId}
     * @allow (get) if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
     * @allow (list) if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
     * @allow (create) if isSignedIn() && request.auth.uid == request.resource.data.senderId;
     * @deny (update, delete) if true;
     * @principle Restricts access to private messages to sender and receiver.
     */
    match /private_messages/{messageId} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if false; // Listing private messages is disabled for privacy.

      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores course information. Anyone can read course information. Only admins or the teacher assigned to the course can modify it.
     * @path /courses/{courseId}
     * @allow (get, list) if true;
     * @allow (create) if isSignedIn() && (isAdmin() || request.auth.uid == request.resource.data.teacherId);
     * @allow (update) if isSignedIn() && (isAdmin() || (resource != null && request.auth.uid == resource.data.teacherId));
     * @allow (delete) if isSignedIn() && (isAdmin() || (resource != null && request.auth.uid == resource.data.teacherId));
     * @principle Allows public read access but restricts write access to admins and assigned teachers.
     */
    match /courses/{courseId} {
      allow get, list: if true;

      allow create: if isSignedIn() && (isAdmin() || request.resource.data.teacherId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    /**
     * @description Stores student grades for courses. Only the student who owns the grade or the teacher who teaches the course can read the grade. Only the teacher who teaches the course can create, update, or delete the grade.
     * @path /grades/{gradeId}
     * @allow (get, list) if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacherForCourse(resource.data.courseId));
     * @allow (create, update, delete) if isSignedIn() && isTeacherForCourse(request.resource.data.courseId);
     * @principle Restricts grade access to the student and the teacher of the course.
     */
    match /grades/{gradeId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacherForCourse(resource.data.courseId));
      allow list: if false; // Listing grades is not allowed for privacy.

      allow create: if isSignedIn() && isTeacherForCourse(request.resource.data.courseId);
      allow update: if isSignedIn() && isTeacherForCourse(resource.data.courseId);
      allow delete: if isSignedIn() && isTeacherForCourse(resource.data.courseId);
    }

    /**
     * @description Stores temporary sessions for QR code login.
     * @path /qr_sessions/{sessionId}
     * @allow get: if true; // Changed to allow get
     * @allow list: if false;
     * @allow create: if true;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Allows public access to temporary QR sessions.
     */
    match /qr_sessions/{sessionId} {
      allow get: if true; // Changed to allow get

      allow list: if false;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isAdmin() {
    return isSignedIn() && request.auth.token.role == 'admin';
  }

  function isTeacherForCourse(courseId) {
    return isSignedIn() && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
  }
}