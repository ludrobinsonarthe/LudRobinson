/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with owner-only restrictions where applicable.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /adminRoles/{roleId}: Stores admin roles and permissions, publicly readable.
 * - /announcements/{announcementId}: Stores school-wide announcements, publicly readable.
 * - /private_messages/{messageId}: Stores private messages, accessible to sender and receiver.
 * - /courses/{courseId}: Stores course information, publicly readable.
 * - /grades/{gradeId}: Stores student grades, accessible only to the student.
 * - /qr_sessions/{sessionId}: Stores QR code login sessions, accessible only if authenticated.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Admin roles are publicly readable but only modifiable through backend functions.
 * - Announcements and courses are publicly readable.
 * - Grades are only readable by the student, but can be create by anyone.
 * - Listing of users, private messages and grades is disallowed to protect privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for profile data.
     * @path /users/{userId}
     * @allow (get, update, delete): User with UID 'user123' can read, update, or delete their own profile at /users/user123.
     * @allow (create): User with UID 'user123' can create their profile at /users/user123.
     * @deny (get, update, delete): User with UID 'user456' cannot read, update, or delete the profile of user 'user123' at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public reading of admin roles.
     * @path /adminRoles/{roleId}
     * @allow (get, list): Any user can read admin role data.
     * @deny (create, update, delete): No client-side creation, updating, or deletion of admin roles.
     * @principle Public read, restricted write access.
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public reading of announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list): Any user can read announcements.
     * @deny (create, update, delete): No client-side creation, updating, or deletion of announcements.
     * @principle Public read, restricted write access.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts access to private messages to sender and receiver.
     * @path /private_messages/{messageId}
     * @allow (get): User can read a message if they are the sender or receiver.
     * @deny (list): Listing of messages is not allowed.
     * @allow (create): User can create a message. The senderId must match the authenticated user's ID.
     * @deny (update, delete): No client-side updating or deletion of messages.
     * @principle Enforces sender/receiver access for private messages.
     */
    match /private_messages/{messageId} {
      allow get: if request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId;
      allow list: if false;
      allow create: if request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }

    /**
     * @description Allows public reading of course information.
     * @path /courses/{courseId}
     * @allow (get, list): Any user can read course data.
     * @deny (create, update, delete): No client-side creation, updating, or deletion of courses.
     * @principle Public read, restricted write access.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts access to grades to the student.
     * @path /grades/{gradeId}
     * @allow (get): Student can read their own grades.
     * @deny (list): Listing of grades is not allowed.
     * @allow (create): Anyone can create a grade. The studentId must match the authenticated user's ID.
     * @deny (update, delete): No client-side updating or deletion of grades.
     * @principle Enforces student-only access for grades.
     */
    match /grades/{gradeId} {
      allow get: if request.auth.uid == resource.data.studentId;
      allow list: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    /**
     * @description Secures QR session data.
     * @path /qr_sessions/{sessionId}
     * @allow (get): User must be authenticated to get the QR Session.
     * @deny (list): Listing is not allowed.
     * @allow (create): User must be authenticated to create a session.
     * @deny (update, delete): Updates and deletes are not allowed
     * @principle Authentication required for access.
     */
    match /qr_sessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper function to determine if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the requesting user is the owner of the document
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Helper function to determine if the requesting user is the owner of the existing document
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}