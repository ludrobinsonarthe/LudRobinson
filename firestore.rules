rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return request.auth.token;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuth() && getUserData().role == 'student';
    }

    function isParent() {
      return isAuth() && getUserData().role == 'parent';
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isParent() 
             && token.childrenUids is map 
             && studentId in token.childrenUids;
    }

    function hasPermission(permission) {
      let token = getUserData();
      return isAdmin() && 
             (
               (token.roleId == 'super_admin') || 
               (token.permissions is map && permission in token.permissions)
             );
    }

    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isTeacher() && token.assignedCourses is map && courseId in token.assignedCourses;
    }

    // =====================================================================
    // Users Collection
    // Roles: Any authenticated (read), Admin (write)
    // =====================================================================
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if hasPermission('manage_users') || hasPermission('manage_students');
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
      allow delete: if hasPermission('manage_users') || hasPermission('manage_students');
    }

    // =====================================================================
    // Admin & Settings Collections
    // Roles: Admin
    // =====================================================================
    match /adminRoles/{roleId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_roles');
    }

    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // Academic Structure
    // Roles: Admin
    // =====================================================================
    match /sectors/{sectorId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /fields/{fieldId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_course');
    }

    match /feeStructures/{feeId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_fees');
    }

    // =====================================================================
    // Grades Collection
    // Roles: Student/Parent (own), Teacher (own course), Admin
    // =====================================================================
    match /grades/{gradeId} {
      allow create: if hasPermission('manage_grades');
      allow read, update: if (isUser(resource.data.studentId) 
                             || isParentOf(resource.data.studentId) 
                             || hasPermission('manage_grades') 
                             || isTeacherOfCourse(resource.data.courseId));
      allow delete: if hasPermission('manage_grades');
    }

    // =====================================================================
    // Payments Collection
    // Roles: Student (own), Admin
    // =====================================================================
    match /payments/{paymentId} {
      allow create: if isUser(request.resource.data.studentId) || hasPermission('manage_tuition');
      allow read, update, delete: if (isUser(resource.data.studentId) || isParentOf(resource.data.studentId)) 
                                  || hasPermission('manage_tuition');
    }

    // =====================================================================
    // Official Documents Collection
    // Roles: Student/Parent (own), Admin
    // =====================================================================
    match /officialDocuments/{docId} {
      allow create: if hasPermission('manage_students');
      allow read: if isUser(resource.data.studentId) 
                   || isParentOf(resource.data.studentId) 
                   || hasPermission('manage_students');
      allow delete: if hasPermission('manage_students');
    }

    // =====================================================================
    // Attendance Collection
    // Roles: Admin
    // =====================================================================
    match /attendances/{attendanceId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_attendance');
    }

    // =====================================================================
    // Financial Collections
    // Roles: Admin
    // =====================================================================
    match /teacherSalaries/{salaryId} {
      allow read, write: if hasPermission('manage_salaries');
    }

    match /cashTransactions/{transactionId} {
      allow read, write: if hasPermission('manage_cash_flow');
    }

    // =====================================================================
    // Messaging & Announcements
    // Roles: Varies
    // =====================================================================
    match /private_messages/{messageId} {
      allow read: if isAuth() && (resource.data.senderId == request.auth.uid 
                                  || resource.data.receiverId == request.auth.uid 
                                  || isAdmin());
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // QR Sessions (Secure)
    // Roles: Any (create), Admin (validate), User (complete)
    // =====================================================================
    match /qr_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly(['status','createdAt','userId']) 
                    && request.resource.data.status == 'pending';
      allow read: if isAuth();
      allow update: if (isAdmin() && request.resource.data.status == 'validated' 
                        && resource.data.userId == request.resource.data.userId)
                     || (isUser(resource.data.userId) && request.resource.data.status == 'completed' 
                         && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}