rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins can do anything
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to read most collections
    match /{collection}/{docId}
    where collection in ['users', 'courses', 'settings', 'adminRoles', 'sectors', 'fields', 'payments', 'grades', 'announcements', 'private_messages', 'attendances', 'officialDocuments', 'teacherSalaries', 'cashTransactions', 'staffAttendances'] {
        allow read: if request.auth != null;
    }
    
    // Users can update their own document
    match /users/{userId} {
        allow update: if request.auth.uid == userId;
    }

    // Admins can write to most collections
    match /{collection}/{docId}
     where collection in ['users', 'courses', 'settings', 'adminRoles', 'sectors', 'fields', 'payments', 'grades', 'announcements', 'private_messages', 'attendances', 'officialDocuments', 'teacherSalaries', 'cashTransactions', 'staffAttendances'] {
      allow write: if isAdmin();
    }
  }
}
