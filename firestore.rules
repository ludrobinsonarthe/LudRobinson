rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      // Check if the user document exists and has the admin role.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for collections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /adminRoles/{roleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /settings/system {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /sectors/{sectorId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /fields/{fieldId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /grades/{gradeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /teacherSalaries/{salaryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /cashTransactions/{transactionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /private_messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isOwner(request.resource.data.senderId);
    }
    
    match /officialDocuments/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /attendances/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /staffAttendances/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /qr_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
  }
}
