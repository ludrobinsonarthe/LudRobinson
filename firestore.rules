rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return request.auth.token;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuth() && getUserData().role == 'teacher';
    }
    
    function isStudent() {
      return isAuth() && getUserData().role == 'student';
    }
    
    function isParent() {
      return isAuth() && getUserData().role == 'parent';
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isParentOf(studentId) {
      let token = getUserData();
      return isParent() && token.childrenUids is map && studentId in token.childrenUids;
    }

    function hasPermission(permission) {
      let token = getUserData();
      return isAdmin() && (token.roleId == 'super_admin' || (token.permissions is map && permission in token.permissions));
    }
    
    function isTeacherOfCourse(courseId) {
      let token = getUserData();
      return isTeacher() && token.assignedCourses is map && courseId in token.assignedCourses;
    }

    // =====================================================================
    // Public & Semi-Public Collections (Readable by all authenticated users)
    // =====================================================================

    // Settings, Sectors, and Fields are needed by all users for UI rendering.
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    match /sectors/{docId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    match /fields/{docId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_admin_settings');
    }
    
    // Roles are needed by admins and for display purposes.
    match /adminRoles/{roleId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_roles');
    }
    
    // =====================================================================
    // Users Collection
    // =====================================================================
    match /users/{userId} {
      allow read: if isAuth();
      // Only admins can create/delete users
      allow create, delete: if hasPermission('manage_users') || hasPermission('manage_students');
      // A user can update their own profile, or an admin can update it.
      allow update: if isUser(userId) || hasPermission('manage_users') || hasPermission('manage_students');
    }
    
    // =====================================================================
    // Announcements & Private Messages
    // =====================================================================
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /private_messages/{messageId} {
        // A user can only read/write messages where they are the sender or receiver
        allow read, write: if isAuth() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }
    
    // =====================================================================
    // Academic & Financial Collections
    // =====================================================================
    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if hasPermission('manage_course');
    }
    
    match /feeStructures/{feeId} {
      allow read: if isAdmin();
      allow write: if hasPermission('manage_fees');
    }

    match /grades/{gradeId} {
      // Students can read their own grades, parents their children's, teachers their courses', admins all.
      allow read: if isAuth() && (
        isUser(resource.data.studentId) ||
        isParentOf(resource.data.studentId) ||
        isTeacherOfCourse(resource.data.courseId) ||
        isAdmin()
      );
      // Only teachers of the course or admins can create/update/delete grades.
      allow write: if hasPermission('manage_grades') || isTeacherOfCourse(request.resource.data.courseId);
    }

    match /payments/{paymentId} {
      // Students can read their own payments, parents their children's, admins all.
      allow read: if isAuth() && (
        isUser(resource.data.studentId) ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      // Students/parents can create payments (for validation), admins can manage them.
      allow create: if isAuth();
      allow update, delete: if hasPermission('manage_tuition');
    }
    
    match /teacherSalaries/{salaryId} {
      // Teachers can read their own salary info, admins can read all.
      allow read: if isAdmin() || isUser(resource.data.teacherId);
      // Only admins can manage salaries.
      allow write: if hasPermission('manage_salaries');
    }
    
    match /cashTransactions/{transactionId} {
      // Only admins can read/write cash transactions.
      allow read, write: if hasPermission('manage_cash_flow');
    }

    match /attendances/{attendanceId} {
        // Teachers can read their own attendance records, admins can read all.
        allow read: if isTeacherOfCourse(resource.data.courseId) || isAdmin();
        // Admins and teachers of the course can create/update records.
        allow write: if hasPermission('manage_attendance') || isTeacherOfCourse(request.resource.data.courseId);
    }
    
    match /officialDocuments/{docId} {
      // Students can read their own documents, parents their children's, admins all.
      allow read: if isAuth() && (
        isUser(resource.data.studentId) ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      // Only admins can create/delete official documents.
      allow write: if hasPermission('manage_admin_settings');
    }

    // =====================================================================
    // QR Sessions (Secure)
    // =====================================================================
    match /qr_sessions/{sessionId} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly(['status','createdAt']) && request.resource.data.status == 'pending';
      allow update: if (isAdmin() || isUser(resource.data.userId)) && request.resource.data.keys().hasAll(['status', 'token', 'userId', 'createdAt']);
      allow delete: if isAdmin();
    }
  }
}