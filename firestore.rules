/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with user-specific ownership where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Accessible only to the user themselves.
 * - /adminRoles/{roleId}: Stores admin roles and permissions. Publicly readable, but write access is denied.
 * - /announcements/{announcementId}: Stores school-wide announcements. Publicly readable, write access denied.
 * - /private_messages/{messageId}: Stores private messages between users. Accessible only to sender and receiver.
 * - /courses/{courseId}: Stores course information. Publicly readable, write access denied.
 * - /grades/{gradeId}: Stores student grades for courses.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login. Write and read access denied.
 *
 * Key Security Decisions:
 * - User data is strictly private and only accessible to the owning user.
 * - Listing of users is disallowed for privacy.
 * - Admin roles, announcements and courses are publicly readable.
 * - Default security posture for ambiguous relationships is strict denial.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with uid 'user123' can create their own profile.
     * @allow (get) User with uid 'user123' can read their own profile.
     * @allow (update) User with uid 'user123' can update their own profile.
     * @deny (create) User with uid 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with uid 'user456' cannot read the profile of 'user123'.
     * @deny (update) User with uid 'user456' cannot update the profile of 'user123'.
     * @principle Enforces document ownership for writes and reads, and validates internal consistency.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin roles.
     * @path /adminRoles/{roleId}
     * @allow (get) Any signed-in user can read admin roles.
     * @deny (create) No one can create admin roles through the client.
     * @principle Admin roles are publicly readable but only manageable through backend functions.
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get) Any signed-in user can read announcements.
     * @deny (create) No one can create announcements through the client.
     * @principle Announcements are publicly readable but only manageable through backend functions.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

     /**
      * @description Controls access to private messages between users.
      * @path /private_messages/{messageId}
      * @allow (get) A user can read a message if they are the sender or receiver.
      * @deny (create) No one can create messages through the client.
      * @principle Only the sender and receiver of a message can read it, and creation is restricted.
      */
    match /private_messages/{messageId} {
        allow get: if false; // TODO: Implement access based on senderId/receiverId
        allow list: if false;
        allow create, update, delete: if false;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get) Any signed-in user can read course information.
     * @deny (create) No one can create courses through the client.
     * @principle Courses are publicly readable but only manageable through backend functions.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to student grades for courses.
     * @path /grades/{gradeId}
     */
    match /grades/{gradeId} {
      allow get: if false; // TODO: Implement access based on studentId/teacherId
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to temporary sessions for QR code login.
     * @path /qr_sessions/{sessionId}
     */
    match /qr_sessions/{sessionId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }
}