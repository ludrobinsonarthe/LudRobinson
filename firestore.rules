/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the owner can read/write their own profile.
 * - /adminRoles/{roleId}: Stores admin roles. Publicly readable, but only admins can modify.
 * - /announcements/{announcementId}: Stores school-wide announcements. Publicly readable, but only admins can create, update, or delete.
 * - /private_messages/{messageId}: Stores private messages. Only the sender or receiver can read a message. Only the sender can create a message.
 * - /courses/{courseId}: Stores course information. Publicly readable, but only teachers can create, update, or delete.
 * - /grades/{gradeId}: Stores student grades. Publicly readable, but only teachers can create, update, or delete.
 * - /qr_sessions/{sessionId}: Stores temporary QR sessions.  Anyone can create, but only the associated user can read/write.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user document.
 * - Listing of user documents is disallowed.
 * - Announcements and courses are publicly readable.
 * - Private messages are accessible only to the sender and receiver.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is the owner of the document.
     * @allow (create) if the user's UID matches the userId.
     * @deny (create) if the user's UID does not match the userId.
     * @deny (list) Always deny listing of users.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Validate that the userId in the path matches the authenticated user's UID.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Validate that the user exists
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin role definitions.
     * @path /adminRoles/{roleId}
     * @allow (get, list) Public read access to admin role definitions.
     * @allow (create, update, delete) Only admins can manage roles.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Restricts role management to admins.
     */
    match /adminRoles/{roleId} {
        function isAdmin() {
            // TODO: Implement a more robust admin check (e.g., via a custom claim).
            return request.auth != null && request.auth.token.role == 'admin';
        }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) Public read access to announcements.
     * @deny (create, update, delete) Only admins can manage announcements.
     * @principle Allows public reading of announcements, but restricts management to admins.
     */
    match /announcements/{announcementId} {
        function isAdmin() {
            // TODO: Implement a more robust admin check (e.g., via a custom claim).
            return request.auth != null && request.auth.token.role == 'admin';
        }
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to private messages between users.
     * @path /private_messages/{messageId}
     * @allow (get) if the user is the sender or receiver.
     * @allow (create) if the user is the sender.
     * @deny (update, delete, list) Always deny updating, deleting, or listing messages.
     * @principle Restricts access to messages to the sender and receiver.
     */
    match /private_messages/{messageId} {
      function isSender(message) {
        return request.auth != null && request.auth.uid == message.senderId;
      }

      function isReceiver(message) {
        return request.auth != null && request.auth.uid == message.receiverId;
      }

      allow get: if isSender(resource.data) || isReceiver(resource.data);
      allow list: if false;
      allow create: if isSender(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get, list) Public read access to course information.
     * @deny (create, update, delete) Only teachers can manage courses.
     * @principle Allows public reading of courses, but restricts management to teachers.
     */
    match /courses/{courseId} {
       function isTeacher() {
            // TODO: Implement a more robust teacher check (e.g., via a custom claim or role).
            return request.auth != null && request.auth.token.role == 'teacher';
        }
      allow get, list: if true;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource != null;
      allow delete: if isTeacher() && resource != null;
    }

    /**
     * @description Controls access to student grades.
     * @path /grades/{gradeId}
     * @allow (get, list) Public read access to grades.
     * @deny (create, update, delete) Only teachers can manage grades.
     * @principle Allows public reading of grades, but restricts management to teachers.
     */
    match /grades/{gradeId} {
      function isTeacher() {
            // TODO: Implement a more robust teacher check (e.g., via a custom claim or role).
            return request.auth != null && request.auth.token.role == 'teacher';
        }

      allow get, list: if true;
      allow create: if isTeacher();
      allow update: if isTeacher() && resource != null;
      allow delete: if isTeacher() && resource != null;
    }

     /**
      * @description Controls access to temporary QR session data.
      * @path /qr_sessions/{sessionId}
      * @allow (get, update, delete) if the user is the owner of the session.
      * @allow (create) if the user is signed in
      * @deny (list) Always deny listing of sessions.
      */
     match /qr_sessions/{sessionId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(qrSession) {
          return request.auth != null && request.auth.uid == qrSession.userId;
        }

        allow get: if isOwner(resource.data);
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isOwner(resource.data) && resource != null;
        allow delete: if isOwner(resource.data) && resource != null;
     }
  }
}