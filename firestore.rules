/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict user-ownership and role-based access control.
 * Schema validation is relaxed to allow for rapid prototyping and data model iteration.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /adminRoles/{roleId}: Stores admin roles and permissions, accessible to admins.
 * - /announcements/{announcementsId}: Stores school-wide announcements, publicly readable, but only creatable, updatable, and deletable by admins.
 * - /private_messages/{messageId}: Stores private messages between users, accessible to sender and receiver.
 * - /courses/{courseId}: Stores course information, publicly readable, but only creatable, updatable, and deletable by admins or teachers.
 * - /grades/{gradeId}: Stores student grades for courses, accessible to the student and teachers.
 * - /qr_sessions/{sessionId}: Stores temporary sessions for QR code login, accessible only during the session and only to the associated user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own data under /users/{userId}.
 * - Listing the /users collection is denied to prevent information disclosure.
 * - Announcements are publicly readable but writable only by admins.
 * - Private messages are only accessible to the sender and receiver.
 * - Courses are publicly readable but writable only by admins or teachers.
 * - Grades are accessible to the student and teachers.
 * - QR sessions are only accessible during the session and only to the associated user.
 *
 * Denormalization for Authorization:
 * - Messages should denormalize senderId and receiverId to enable secure access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Prevents listing the entire /users collection.
     * @path /users
     * @allow None - Listing is always denied.
     * @deny list: Any attempt to list the users collection.
     * @principle Prevents unauthorized enumeration of user accounts.
     */
    match /users {
      allow list: if false;
    }

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get) User with matching {userId} can read their own profile.
     * @allow (create) User with matching {userId} can create their own profile.
     * @allow (update) User with matching {userId} can update their own profile.
     * @allow (delete) User with matching {userId} can delete their own profile.
     * @deny (get) User trying to read another user's profile.
     * @deny (create) User trying to create a profile with a mismatched ID.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin roles and permissions.
     * @path /adminRoles/{roleId}
     * @allow (get) Admin can read any admin role.
     * @allow (create) Admin can create new admin roles.
     * @allow (update) Admin can update existing admin roles.
     * @allow (delete) Admin can delete admin roles.
     * @deny (get) Non-admin trying to read admin roles.
     * @deny (create) Non-admin trying to create admin roles.
     * @principle Restricts admin role management to authorized personnel.
     */
    match /adminRoles/{roleId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list) Any user can read announcements.
     * @allow (create) Only admins can create announcements. The announcement must contain a 'senderId' field that matches the admin's UID.
     * @allow (update) Only admins can update announcements.
     * @allow (delete) Only admins can delete announcements.
     * @deny (create) Non-admins trying to create announcements.
     * @principle Allows public reading of announcements, but restricts modifications to admins.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Controls access to private messages between users.
     * @path /private_messages/{messageId}
     * @allow (get) Sender and receiver can read the message.
     * @allow (create) Sender can create a message with their UID as the senderId.
     * @allow (update) Sender can update the message.
     * @allow (delete) Sender can delete the message.
     * @deny (get) Users other than the sender or receiver trying to read the message.
     * @principle Restricts message access to participating users.
     */
    match /private_messages/{messageId} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.senderId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.senderId);
      allow list: if false; // Listing messages is disabled.
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (get, list) Any user can read course information.
     * @allow (create) Only admins or teachers can create courses. The course must contain a 'teacherId' that matches their UID.
     * @allow (update) Only admins or the assigned teacher can update the course.
     * @allow (delete) Only admins can delete courses.
     * @deny (create) Non-admins/teachers trying to create courses.
     * @principle Allows public reading of courses, but restricts modifications to admins and teachers.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (isAdmin() || isTeacher()) && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isCourseTeacher(resource.data.teacherId)) && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Controls access to student grades for courses.
     * @path /grades/{gradeId}
     * @allow (get, list) Student and teachers can read the grade.
     * @allow (create) Only admins or teacher can create grades. The grades must contain a 'studentId' and a 'courseId'.
     * @allow (update) Only admins or teachers can update the grade.
     * @allow (delete) Only admins can delete the grade.
     * @deny (get) Users other than the student or teacher trying to read the grade.
     * @principle Restricts grade access to participating users.
     */
    match /grades/{gradeId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if isSignedIn() && (isAdmin() || isTeacher());
      allow update: if isSignedIn() && (isAdmin() || isTeacher()) && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Controls access to temporary sessions for QR code login.
     * @path /qr_sessions/{sessionId}
     * @allow (get) Any user can read qrsession.
     * @allow (create) Any user can create a new qr session
     * @allow (update) The user associated with the session can update the session's status.
     * @allow (delete) No one can delete.
     * @principle Restricts session modification to the associated user.
     */
    match /qr_sessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if true;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && resource != null;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
        return isSignedIn() && request.auth.token.role == 'teacher';
    }

    function isCourseTeacher(teacherId) {
      return isSignedIn() && request.auth.uid == teacherId;
    }
  }
}