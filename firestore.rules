/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model. Users can only access their own data
 * unless they have specific admin roles. Data validation is relaxed in this prototyping phase,
 * focusing on authorization and relational integrity.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Access is restricted to the owner and potentially admins.
 * - /adminRoles/{roleId}: Defines admin roles and their associated permissions. Read-only for all authenticated users.
 * - /announcements/{announcementId}: Publicly readable collection for school-wide announcements. Only admins can create/modify.
 * - /private_messages/{messageId}: Stores private messages between users. Sender and Receiver has access.
 * - /courses/{courseId}: Stores course information. Publicly readable, but create/update/delete only by authorized users.
 * - /grades/{gradeId}: Stores student grades. Only student and teacher can see a grade
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent information leakage.
 * - Public read access is granted for announcements and courses to facilitate information sharing.
 * - Role-based access control (RBAC) is used to manage admin privileges.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `request.auth.uid` to verify ownership of documents and restrict access to authorized users.
 * - No denormalization is performed in this iteration.
 *
 * Structural Segregation:
 * - Private messages are stored in a separate collection (`/private_messages`) to ensure privacy and prevent unauthorized access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (read, write): User with matching UID.
     * @deny (read, write): Any other user.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the request is made by the owner of the user document
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      // Helper function to check if the request is made by an existing owner of the user document
      function isExistingOwner(userId) {
        return isOwner(userId) && get(resource).data != null;
      }
      // Allow a user to read their own profile
      allow get: if isOwner(userId);
      // Allow a user to list all user profiles
      allow list: if false;
      // Allow a user to create their own profile
      allow create: if isOwner(userId);
      // Allow a user to update their own profile
      allow update: if isExistingOwner(userId);
      // Allow a user to delete their own profile
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin roles.
     * @path /adminRoles/{roleId}
     * @allow (read): Any authenticated user.
     * @deny (write): Only admins can modify admin roles (Not implemented).
     * @principle Limits modification of admin roles to authorized users.
     */
    match /adminRoles/{roleId} {
      // Helper function to check if the request is made by an admin
      function isAdmin() {
        return false;
      }
      // Allow any authenticated user to read admin roles
      allow get, list: if true;
      // Allow admins to create admin roles
      allow create: if isAdmin();
      // Allow admins to update admin roles
      allow update: if isAdmin();
      // Allow admins to delete admin roles
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow (read): Any user can read announcements.
     * @deny (write): Only admins can create, update, or delete announcements.
     * @principle Allows public reading of announcements, restricts writes to admins.
     */
    match /announcements/{announcementId} {
      // Allow any user to read announcements
      allow get, list: if true;
      // Allow admins to create announcements
      allow create: if isAdmin();
      // Allow admins to update announcements
      allow update: if isAdmin();
      // Allow admins to delete announcements
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to private messages.
     * @path /private_messages/{messageId}
     * @allow (read): Only the sender or receiver can read the message.
     * @deny (write): Only the sender can create a new message.
     * @principle Ensures that only the intended recipients can read private messages.
     */
    match /private_messages/{messageId} {
      // Helper function to check if the request is made by the sender or receiver of the message
      function isSenderOrReceiver(message) {
        return request.auth != null && (request.auth.uid == message.senderId || request.auth.uid == message.receiverId);
      }
      // Allow the sender or receiver to read the message
      allow get: if isSenderOrReceiver(resource.data);
      //Cannot perform list operation with security
      allow list: if false;
      // Allow the sender to create a new message
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      // Only the owner can update a private message
      allow update: if request.auth.uid == resource.data.senderId;
      // Only the owner can delete a private message
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    /**
     * @description Controls access to course information.
     * @path /courses/{courseId}
     * @allow (read): Any user can read course information.
     * @deny (write): Only admins or teachers can create, update, or delete courses.
     * @principle Allows public reading of course information, restricts writes to authorized users.
     */
    match /courses/{courseId} {
      // Allow any user to read course information
      allow get, list: if true;
      // Allow admins or teachers to create courses
      allow create: if isAdmin();
      // Allow admins or teachers to update courses
      allow update: if isAdmin();
      // Allow admins or teachers to delete courses
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to student grades.
     * @path /grades/{gradeId}
     * @allow (read): Only the student or teacher can read the grade.
     * @deny (write): Only teachers can create, update, or delete grades (Not implemented).
     * @principle Ensures that only the student and teachers involved can read the grade.
     */
    match /grades/{gradeId} {
      // Helper function to check if the request is made by the student or teacher
      function isStudentOrTeacher(grade) {
        return request.auth != null && (request.auth.uid == grade.studentId);
      }

        function isTeacherForGrade(grade) {
            return request.auth != null && grade.teacherId == request.auth.uid;
        }
      // Allow the student or teacher to read the grade
      allow get: if isStudentOrTeacher(resource.data) || isTeacherForGrade(resource.data);
      allow list: if false;
      // Allow teachers to create grades
      allow create: if request.auth.uid == request.resource.data.teacherId;
      // Allow teachers to update grades
      allow update: if request.auth.uid == resource.data.teacherId;
      // Allow teachers to delete grades
      allow delete: if request.auth.uid == resource.data.teacherId;
    }

    /**
     * @description Controls access to QR code sessions.
     * @path /qr_sessions/{sessionId}
     * @allow (read, write): Only the associated user can access the session.
     * @deny (read, write): Any other user.
     * @principle Ensures that only the user associated with the QR code can access the session.
     */
    match /qr_sessions/{sessionId} {
      // Helper function to check if the request is made by the associated user
      function isAssociatedUser(qrSession) {
        return request.auth != null && request.auth.uid == qrSession.userId;
      }
      // Allow the associated user to read the session
      allow get: if isAssociatedUser(resource.data);
      allow list: if false;
      // Allow the associated user to create a session
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow the associated user to update the session
      allow update: if isAssociatedUser(getAfter(resource).data);
      // Allow the associated user to delete the session
      allow delete: if isAssociatedUser(resource.data);
    }
  }
}