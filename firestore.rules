
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function isParentOf(studentId) {
        let parentData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return isAuth() && parentData.role == 'parent' && studentId in parentData.parent.childrenUids;
    }
    
    function isTeacher() {
        return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Settings, Roles, Sectors, Fields, Courses are public read
    match /{path=**}/settings/system {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminRoles/{roleId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
     match /sectors/{sectorId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
     match /fields/{fieldId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }
     match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /feeStructures/{fsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Users can read their own profile, admins can read/write all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isParentOf(userId) && get(/databases/$(database)/documents/users/$(userId)).data.role == 'student') || isTeacher();
      allow update: if isOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Grades can be read by owner, parent or admin. Can be written by admin or assigned teacher.
    match /grades/{gradeId} {
        let studentId = resource.data.studentId;
        let courseId = resource.data.courseId;
        let teacherId = get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId;

        allow read: if isOwner(studentId) || isParentOf(studentId) || isAdmin() || isOwner(teacherId);
        allow create, update, delete: if isAdmin() || isOwner(teacherId);
    }
    
    // Payments can be read by owner/parent, managed by admin
    match /payments/{paymentId} {
        let studentId = resource.data.studentId;
        allow read: if isOwner(studentId) || isParentOf(studentId) || isAdmin();
        allow create, update, delete: if isAdmin();
    }
    
    // Messages (private) can be read by sender or receiver
    match /messages/{messageId} {
        allow read, create: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
        // Announcements can be read by anyone authed and targetted, but only created/deleted by admin
        allow read: if isAuth() && resource.data.type == 'announcement';
        allow create, delete, update: if isAdmin();
    }
    
    // Official documents can be read by owner/parent, created by admin
    match /officialDocuments/{docId} {
        let studentId = resource.data.studentId;
        allow read: if isOwner(studentId) || isParentOf(studentId) || isAdmin();
        allow create, delete: if isAdmin();
    }
    
    // Salaries can only be handled by admins
    match /teacherSalaries/{salaryId} {
        allow read, create, update, delete: if isAdmin();
    }
    
    // Cash flow can only be handled by admins
    match /cashTransactions/{transactionId} {
        allow read, create, delete: if isAdmin();
    }
    
    // Attendance can be read by involved teacher/student/parent, managed by admin
    match /attendances/{attendanceId} {
        let teacherId = resource.data.teacherId;
        let studentIds = resource.data.studentAttendances.map(sa => sa.studentId);
        allow read: if isAdmin() || isOwner(teacherId) || request.auth.uid in studentIds;
        allow create, update, delete: if isAdmin();
    }

    // QR Sessions for mobile login
    match /qr_sessions/{sessionId} {
      allow read, create: if true; // Open for requester to listen
      allow update: if isAuth();   // Only an authenticated user can validate
      allow delete: if true; // Allows cleanup
    }

  }
}
