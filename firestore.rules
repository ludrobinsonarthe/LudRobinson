/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, with specific rules for user profiles, admin roles, announcements, private messages, courses, grades, and QR sessions.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 * - /adminRoles/{roleId}: Stores admin roles and their associated permissions, publicly readable.
 * - /announcements/{announcementId}: Stores school-wide announcements, publicly readable but only writable by authorized users.
 * - /private_messages/{messageId}: Stores private messages between users, accessible only to the sender and receiver.
 * - /courses/{courseId}: Stores course information, publicly readable, but creates/updates only by authorized users.
 * - /grades/{gradeId}: Stores student grades, accessible only to the student and teachers.
 * - /qr_sessions/{sessionId}: Stores QR code login sessions.
 *
 * Key Security Decisions:
 * - User profiles are strictly private, with access limited to the owning user.
 * - Admin roles are publicly readable to simplify UI logic, but write access is restricted.
 * - Announcements and Courses are publicly readable but only writable by authorized users (e.g., admins, teachers).
 * - Private messages are secured to sender and receiver only.
 * - Grades are accessible to the student and teachers.
 * - Listing of users is explicitly denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, update, delete) if the user is the owner of the profile.
     * @allow (create) if the user is creating their own profile.
     * @deny list
     * @deny (create, update, delete) if the user is not authenticated.
     * @principle Enforces document ownership for user profiles, restricting access to the owner.
     */
    match /users/{userId} {
      //is user signed in
      function isSignedIn() {
        return request.auth != null;
      }

      //is user the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      //is user existing owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages admin roles and permissions.
     * @path /adminRoles/{roleId}
     * @allow get, list: Publicly readable.
     * @deny create, update, delete
     * @principle Restricts modification of admin roles to authorized users.
     */
    match /adminRoles/{roleId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages school-wide announcements.
     * @path /announcements/{announcementId}
     * @allow get, list: Publicly readable.
     * @deny create, update, delete: // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Allows public reading of announcements, but restricts creation, updating, and deletion.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages private messages between users.
     * @path /private_messages/{messageId}
     * @allow get: if the user is the sender or receiver of the message.
     * @allow create: if the user is authenticated.
     * @deny list
     * @deny update, delete
     * @principle Restricts access to private messages to the sender and receiver only.
     */
    match /private_messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isSenderOrReceiver(senderId, receiverId) {
        return request.auth.uid == senderId || request.auth.uid == receiverId;
      }

      function isExistingSenderOrReceiver(senderId, receiverId) {
        return isSenderOrReceiver(senderId, receiverId) && resource != null;
      }

      allow get: if isSignedIn() && isExistingSenderOrReceiver(resource.data.senderId, resource.data.receiverId);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages course information.
     * @path /courses/{courseId}
     * @allow get, list: Publicly readable.
     * @deny create, update, delete
     * @principle Allows public reading of course information, but restricts creation, updating, and deletion.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages student grades for courses.
     * @path /grades/{gradeId}
     * @allow get: if the user is the student or a teacher.
     * @deny list
     * @deny create, update, delete
     * @principle Restricts access to grades to the student and teachers.
     */
    match /grades/{gradeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isStudentOrTeacher(studentId) {
        //Need to have teacherId to check teacher
        return request.auth.uid == studentId;
      }

      allow get: if isSignedIn() && isStudentOrTeacher(resource.data.studentId);
      allow list: if false;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages temporary sessions for QR code login.
     * @path /qr_sessions/{sessionId}
     * @allow get, create, update: if the user is authenticated.
     * @deny list, delete
     * @principle Allows authenticated users to manage their QR code login sessions.
     */
    match /qr_sessions/{sessionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, create, update: if isSignedIn();
      allow list: if false;
      allow delete: if false;
    }
  }
}