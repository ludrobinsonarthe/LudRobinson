rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }
    
    function isTeacher() {
      return isRole('teacher');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isParentOf(studentId) {
      let parentUid = getUserData(studentId).student.parentUid;
      return parentUid != null && isOwner(parentUid);
    }
    
    function isTeacherOfCourse(courseId) {
      return isTeacher() && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    // =================================
    // Collection Rules
    // =================================

    // Publicly readable data, but only writable by admins
    match /{path=**}/settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sectors/{sectorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /fields/{fieldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /adminRoles/{roleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /feeStructures/{fsId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Courses are readable by any signed-in user, but only writable by admins
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      // Admins can manage all users.
      allow read, write: if isAdmin();
      
      // Users can read/update their own profile.
      allow get, update: if isOwner(userId);
      
      // A parent can read their child's data.
      allow get: if isParentOf(userId);
      
      // Students can read their classmates' basic info.
      allow read: if isRole('student') && getUserData(userId).role == 'student';
      
      // Teachers can read their students' info.
      allow read: if isTeacher();
    }

    // Grades Collection
    match /grades/{gradeId} {
        // Admins can do anything with grades.
        allow read, write: if isAdmin();

        // Students can read their own grades. Parents can read their children's grades.
        allow read: if isOwner(resource.data.studentId) || isParentOf(resource.data.studentId);
        
        // Teachers can create/update grades for their own courses.
        allow create, update: if isTeacherOfCourse(request.resource.data.courseId);
    }

    // Payments Collection
    match /payments/{paymentId} {
        // Admins manage all payments.
        allow read, write: if isAdmin();

        // Students can read their own payments. Parents can read their children's payments.
        allow read: if isOwner(resource.data.studentId) || isParentOf(resource.data.studentId);
    }
    
    // Messages (Announcements & Private)
    match /messages/{messageId} {
        // Admins can manage all messages.
        allow read, write: if isAdmin();

        // Users can read announcements targeted to them.
        allow read: if resource.data.type == 'announcement';

        // Users can read private messages where they are the sender or receiver.
        allow read: if resource.data.type == 'private' && (isOwner(resource.data.senderId) || isOwner(resource.data.receiverId));

        // Any signed-in user can send a private message.
        allow create: if isSignedIn() && request.resource.data.type == 'private';
    }
    
    // Official Documents
    match /officialDocuments/{docId} {
      // Admins manage all official documents.
      allow read, write: if isAdmin();
      
      // Students can read their own documents. Parents can read their children's.
      allow read: if isOwner(resource.data.studentId) || isParentOf(resource.data.studentId);
    }
    
    // Attendance records
    match /attendances/{attId} {
      // Only admins can read/write attendance records.
      allow read, write: if isAdmin();
    }

    // Teacher Salaries
    match /teacherSalaries/{salaryId} {
      // Only admins can manage salaries.
      allow read, write: if isAdmin();
    }
    
    // Cash Transactions
    match /cashTransactions/{transacId} {
      // Only admins can manage cash flow.
      allow read, write: if isAdmin();
    }
    
    // QR Sessions for login
    match /qr_sessions/{sessionId} {
      allow read, write: if true; // Open for the login flow to work
    }
  }
}