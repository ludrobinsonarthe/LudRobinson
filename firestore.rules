rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      // An admin is a user who has the role 'admin' in their own user document.
      // We check the resource in the database.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =================================
    //  Users Collection
    // =================================
    match /users/{userId} {
      // ANY authenticated user can create their own user document (e.g. on first sign-up)
      // For now, we will allow admins to create users.
      allow create: if request.auth != null;

      // A user can read their OWN document. Admins can read ANY document.
      allow read: if request.auth.uid == userId || isAdmin();

      // A user can update their OWN document. Admins can update ANY document.
      allow update: if request.auth.uid == userId || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // =================================
    //  Admin Roles, Settings, and Structure
    // =================================
    match /adminRoles/{roleId} {
      // Only admins can manage roles.
      allow read, write, delete: if isAdmin();
    }
    
    match /settings/system {
      // Any authenticated user can read the system settings (school name, logo).
      allow read: if request.auth != null;
      // Only admins can change system settings.
      allow write: if isAdmin();
    }

    match /sectors/{sectorId} {
      // Anyone can read sectors.
      allow read: if request.auth != null;
      // Only admins can manage sectors.
      allow write: if isAdmin();
    }

    match /fields/{fieldId} {
       // Anyone can read fields.
      allow read: if request.auth != null;
      // Only admins can manage fields.
      allow write: if isAdmin();
    }

    match /feeStructures/{feeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    

    // =================================
    //  Core Academic Data
    // =================================
    match /courses/{courseId} {
      // Any authenticated user can read course details.
      allow read: if request.auth != null;
      // Only admins can create, update, or delete courses.
      allow write, delete: if isAdmin();
    }
    
    match /grades/{gradeId} {
      // Students can read their own grades.
      // Teachers can read grades for their courses.
      // Admins can read all grades.
      allow read: if request.auth.uid == resource.data.studentId || isAdmin();

      // Admins and teachers can create/update grades.
      // A teacher can only modify grades for a course they teach.
      allow write: if isAdmin();
    }

    match /attendances/{attendanceId} {
        allow read, write: if isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }


    // =================================
    //  Financial Data
    // =================================
    match /payments/{paymentId} {
      // Students can read their own payments.
      allow read: if request.auth.uid == resource.data.studentId || isAdmin();
      // Students can create payments (pending status). Admins can manage all payments.
      allow create: if request.auth.uid == request.resource.data.studentId;
      allow update, delete: if isAdmin();
    }

    match /teacherSalaries/{salaryId} {
      // A teacher can read their own salary details.
      allow read: if request.auth.uid == resource.data.teacherId || isAdmin();
      // Only admins can create, update, or delete salary records.
      allow write, delete: if isAdmin();
    }

    match /cashTransactions/{transactionId} {
        allow read, write, delete: if isAdmin();
    }
    
    
    // =================================
    //  Communication & Documents
    // =================================
    match /messages/{messageId} {
      // An announcement can be read by its target audience.
      // A private message can only be read by the sender or receiver.
      allow read: if (resource.data.type == 'announcement' && resource.data.receiverId in ['all', get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role, get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin.roleId]) ||
                     (resource.data.type == 'private' && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId));
                     
      // Any authenticated user can create a message.
      allow create: if request.auth != null;
      
      // Admins can delete any message (moderation).
      allow delete: if isAdmin();
    }

    match /officialDocuments/{docId} {
        // A user can read their own documents. Admins can read all documents.
        allow read: if request.auth.uid == resource.data.studentId || isAdmin();
        // Only admins can issue documents.
        allow write: if isAdmin();
    }
    
    // =================================
    //  Session Sharing
    // =================================
    match /qr_sessions/{sessionId} {
      // Anyone can create a session document to display a QR code
      allow create: if true;
      // An authenticated user can update a session to validate it.
      allow update: if request.auth != null;
      // The session creator or the validator can read/delete it.
      allow read, delete: if request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/qr_sessions/$(sessionId)).data.status == 'pending';
    }

  }
}
