
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Files are world-readable by default
    match /{allPaths=**} {
      allow read;
    }

    // Allow admins to write to the official_documents folder
    match /official_documents/{userId}/{allPaths=**} {
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow users to read their own documents if they are the user or an admin
    match /official_documents/{userId}/{allPaths=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Allow admins and users to write their own avatars
    match /avatars/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read;
    }

    // Logos are publicly readable
    match /logos/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
