rules_version = '2';

// Règles pour Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {

    // Autoriser la lecture publique de tous les fichiers
    match /{allPaths=**} {
      allow read;
    }

    // Sécuriser les téléversements : seuls les utilisateurs authentifiés peuvent écrire
    // dans des dossiers spécifiques.
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /courses/{courseId}/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
