rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: Publicly readable, but only the owner can write.
    match /avatars/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Logos: Publicly readable, admins can write.
    match /logos/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Official Documents: Readable by the student or any admin. Writable only by admins.
    match /official_documents/{studentId}/{allPaths=**} {
      allow read: if request.auth != null && 
                   (request.auth.uid == studentId || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && 
                    get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
