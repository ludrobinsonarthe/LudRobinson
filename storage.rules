rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // General access control for all files
    match /{allPaths=**} {
      // By default, deny all reads and writes
      allow read, write: if false;
    }

    // Allow read/write access to user avatars
    match /avatars/{userId} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read/write access to logos (only for admins)
    match /logos/{allPaths=**} {
       allow read; // All users can read the logo
       allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for official documents
    match /official_documents/{studentId}/{document=**} {
      // Allow read access if the user is the student owner of the document
      // OR if the user has an 'admin' role in Firestore.
      allow read: if request.auth != null && (
        (request.auth.uid == studentId) ||
        (get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );

      // Allow write access (create, update, delete) only for admin users.
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
