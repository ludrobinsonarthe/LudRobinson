rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read for logos and user avatars
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId; // User can only write to their own avatar path
    }

    // Secure official documents
    match /official_documents/{studentId}/{fileName} {
      // A student can read their own documents.
      allow read: if request.auth != null && request.auth.uid == studentId;
      // An admin (or any authenticated user via the app's secure logic) can upload documents.
      // The path security (knowing the studentId) provides a layer of protection.
      allow write: if request.auth != null;
    }
    
    // Default deny all other routes
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
