rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read on logos and user avatars
    match /logos/{allPaths=**} {
      allow read;
    }
    match /avatars/{allPaths=**} {
      allow read;
      allow write: if request.auth != null; // Allow logged-in users to update their own avatar
    }

    // Rules for official documents
    match /official_documents/{studentId}/{allPaths=**} {
      // Allow read access to the student who owns the document or any admin
      allow read: if request.auth != null &&
                   (studentId == request.auth.uid || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Allow write access only to admins
      allow write: if request.auth != null &&
                    get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
